void DrawInfoTab() {
    int wins=0,losses=0,deals=0; double pnl=TodayNetProfit(wins,losses,deals); double spread=(SymbolInfoDouble(_Symbol,SYMBOL_ASK)-SymbolInfoDouble(_Symbol,SYMBOL_BID))/_Point;
