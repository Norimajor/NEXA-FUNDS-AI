string DashboardBool(bool value) { return value ? "ON" : "OFF"; }

// At 100% scale this is about 284 px, or 7.5 cm on a 96-DPI display.
const double DASHBOARD_WIDTH_FACTOR=0.63;
double DashboardScaleFactor() { return DASHBOARD_WIDTH_FACTOR*(double)dashboard_scale/100.0; }
int DS(int value) { return (int)MathRound(value*DashboardScaleFactor()); }

//--- central theme engine: one accent drives every themed element ---
color ThemeAccentFor(int theme) {
    switch(theme) {
        case 1: return C'46,204,113';   // GREEN
        case 2: return C'56,152,236';   // BLUE
        case 3: return C'231,76,60';    // RED
        case 4: return C'155,89,182';   // VIOLET
        case 5: return C'26,188,196';   // CYAN
        case 6: return C'189,195,199';  // SILVER
        case 7: return C'243,156,18';   // AMBER
        default: return C'214,167,84';  // GOLD
    }
}
int ColR(color c) { return (int)(((int)c)&0xFF); }
int ColG(color c) { return (int)((((int)c)>>8)&0xFF); }
int ColB(color c) { return (int)((((int)c)>>16)&0xFF); }
//--- share is the proportion of colour a kept in the mix
color MixColor(color a,color b,double share) {
    if(share<0)share=0; if(share>1)share=1;
    int r=(int)MathRound(ColR(a)*share+ColR(b)*(1.0-share));
    int g=(int)MathRound(ColG(a)*share+ColG(b)*(1.0-share));
    int bl=(int)MathRound(ColB(a)*share+ColB(b)*(1.0-share));
    return (color)((bl<<16)|(g<<8)|r);
}
color DashAccent()      { return ThemeAccentFor(dashboard_theme); }
color DashBg()          { return MixColor(DashAccent(),C'10,11,13',0.42); }
color DashPanel()       { return MixColor(DashAccent(),C'13,15,18',0.12); }
color DashCard()        { return MixColor(DashAccent(),C'18,20,23',0.10); }
color DashSoft()        { return MixColor(DashAccent(),C'32,35,40',0.12); }
color DashText()        { return C'233,236,241'; }
color DashMuted()       { return C'146,152,163'; }
color DashGreen()       { return C'52,211,153'; }
color DashRed()         { return C'248,113,113'; }
//--- themed borders and fills, subtle over the dark base
color DashBorder()      { return MixColor(DashAccent(),C'56,60,68',0.42); }
color DashBorderSoft()  { return MixColor(DashAccent(),C'44,48,56',0.20); }
color DashAccentFill()  { return MixColor(DashAccent(),DashPanel(),0.20); }
color DashOnAccent()    { return C'15,16,18'; }
color ChartBackground() { return (color)ChartGetInteger(0,CHART_COLOR_BACKGROUND); }
//--- shared typography
string FontRegular()    { return "Segoe UI"; }
string FontMedium()     { return "Segoe UI Semibold"; }
string FontNumeric()    { return "Consolas"; }

string DashName(string name) { return dashboard_prefix+name; }
void SetObjectVisible(string name,bool visible) { if(ObjectFind(0,DashName(name))>=0) ObjectSetInteger(0,DashName(name),OBJPROP_TIMEFRAMES,visible?OBJ_ALL_PERIODS:OBJ_NO_PERIODS); }

//--- raw pixel rectangle, used for corner masks and hairlines
void RawRect(string name,int px,int py,int w,int h,color bg,int zorder) {
    string n=DashName(name); if(ObjectFind(0,n)<0) ObjectCreate(0,n,OBJ_RECTANGLE_LABEL,0,0,0);
    ObjectSetInteger(0,n,OBJPROP_CORNER,InpDashboardCorner);
    ObjectSetInteger(0,n,OBJPROP_XDISTANCE,px); ObjectSetInteger(0,n,OBJPROP_YDISTANCE,py);
    ObjectSetInteger(0,n,OBJPROP_XSIZE,MathMax(1,w)); ObjectSetInteger(0,n,OBJPROP_YSIZE,MathMax(1,h));
    ObjectSetInteger(0,n,OBJPROP_BGCOLOR,bg); ObjectSetInteger(0,n,OBJPROP_BORDER_TYPE,BORDER_FLAT); ObjectSetInteger(0,n,OBJPROP_COLOR,bg);
    ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false); ObjectSetInteger(0,n,OBJPROP_HIDDEN,true); ObjectSetInteger(0,n,OBJPROP_ZORDER,zorder);
}
//--- MT5 objects are square, so the corners are masked with the surrounding colour
void RoundCorners(string base,int px,int py,int pw,int ph,color outer,int radius,int zorder) { /* Native square objects: no costly masking objects. */ }
void SetDashboardLabel(string name,string text,int x,int y,int font_size,color text_color,string font="") {
    string n=DashName(name); if(ObjectFind(0,n)<0) ObjectCreate(0,n,OBJ_LABEL,0,0,0);
    ObjectSetInteger(0,n,OBJPROP_CORNER,InpDashboardCorner); ObjectSetInteger(0,n,OBJPROP_XDISTANCE,dashboard_x+DS(x));
    ObjectSetInteger(0,n,OBJPROP_YDISTANCE,dashboard_y+DS(y)); ObjectSetInteger(0,n,OBJPROP_FONTSIZE,MathMax(6,DS(font_size)));
    ObjectSetInteger(0,n,OBJPROP_COLOR,text_color); ObjectSetInteger(0,n,OBJPROP_ANCHOR,ANCHOR_LEFT_UPPER);
    ObjectSetString(0,n,OBJPROP_FONT,font==""?FontRegular():font); ObjectSetString(0,n,OBJPROP_TEXT,text);
    ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false); ObjectSetInteger(0,n,OBJPROP_HIDDEN,true); ObjectSetInteger(0,n,OBJPROP_ZORDER,14);
}
void SetDashboardPanel(string name,int x,int y,int width,int height,color bg,color border,bool draggable=false) {
    string n=DashName(name); bool created=ObjectFind(0,n)<0;
    if(created) ObjectCreate(0,n,OBJ_RECTANGLE_LABEL,0,0,0);
    ObjectSetInteger(0,n,OBJPROP_CORNER,InpDashboardCorner); ObjectSetInteger(0,n,OBJPROP_XDISTANCE,dashboard_x+DS(x)); ObjectSetInteger(0,n,OBJPROP_YDISTANCE,dashboard_y+DS(y));
    ObjectSetInteger(0,n,OBJPROP_XSIZE,DS(width)); ObjectSetInteger(0,n,OBJPROP_YSIZE,DS(height));
    ObjectSetInteger(0,n,OBJPROP_BGCOLOR,bg);
    //--- rectangle labels take their border colour from OBJPROP_COLOR with a flat border
    ObjectSetInteger(0,n,OBJPROP_BORDER_TYPE,BORDER_FLAT); ObjectSetInteger(0,n,OBJPROP_COLOR,border);
    ObjectSetInteger(0,n,OBJPROP_SELECTABLE,draggable);
    if(created) ObjectSetInteger(0,n,OBJPROP_SELECTED,false);
    ObjectSetInteger(0,n,OBJPROP_HIDDEN,!draggable); ObjectSetInteger(0,n,OBJPROP_ZORDER,draggable?2:0);
}
//--- panel with masked (rounded) corners
void SetRoundedPanel(string name,int x,int y,int width,int height,color bg,color border,color outer,int radius=3,bool draggable=false) {
    SetDashboardPanel(name,x,y,width,height,bg,border,draggable);
    RoundCorners(name,dashboard_x+DS(x),dashboard_y+DS(y),DS(width),DS(height),outer,MathMax(DS(radius),DS(16)),draggable?3:1);
}
void SetDashboardButton(string name,string text,int x,int y,int width,int height,color bg,color border,color text_color=clrWhite,color outer=clrNONE,int radius=2) {
    string n=DashName(name); if(ObjectFind(0,n)<0) ObjectCreate(0,n,OBJ_BUTTON,0,0,0);
    ObjectSetInteger(0,n,OBJPROP_CORNER,InpDashboardCorner); ObjectSetInteger(0,n,OBJPROP_XDISTANCE,dashboard_x+DS(x));
    ObjectSetInteger(0,n,OBJPROP_YDISTANCE,dashboard_y+DS(y)); ObjectSetInteger(0,n,OBJPROP_XSIZE,DS(width)); ObjectSetInteger(0,n,OBJPROP_YSIZE,DS(height));
    ObjectSetInteger(0,n,OBJPROP_FONTSIZE,MathMax(6,DS(8))); ObjectSetInteger(0,n,OBJPROP_COLOR,text_color);
    ObjectSetInteger(0,n,OBJPROP_BGCOLOR,bg); ObjectSetInteger(0,n,OBJPROP_BORDER_COLOR,bg);
    ObjectSetString(0,n,OBJPROP_FONT,FontMedium()); ObjectSetString(0,n,OBJPROP_TEXT,text);
    ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false); ObjectSetInteger(0,n,OBJPROP_HIDDEN,true); ObjectSetInteger(0,n,OBJPROP_ZORDER,10);
    RoundCorners(name,dashboard_x+DS(x),dashboard_y+DS(y),DS(width),DS(height),outer==clrNONE?DashBg():outer,MathMax(DS(radius),DS(10)),12);
}
void DrawSection(string title,int y) {
    SetDashboardPanel("SBAR_"+title,16,y+2,3,12,DashAccent(),DashAccent());
    SetDashboardLabel("SEC_"+title,title,25,y,9,DashAccent(),FontMedium());
}
void DrawToggle(string name,string caption,bool value,int x,int y,int w=128) {
    color on_bg=MixColor(DashGreen(),DashPanel(),0.18), off_bg=DashPanel();
    SetDashboardButton(name,caption+"  "+DashboardBool(value),x,y,w,25,value?on_bg:off_bg,value?DashGreen():DashSoft(),value?DashGreen():DashMuted());
}
void DrawMetric(string name,string title,string value,int x,int y,int w=126) {
    SetRoundedPanel("BOX_"+name,x,y,w,53,DashCard(),DashBorderSoft(),DashBg(),3);
    SetDashboardLabel("BT_"+name,title,x+10,y+8,7,DashMuted());
    SetDashboardLabel("BV_"+name,value,x+10,y+24,11,DashText(),FontNumeric());
}
double TodayNetProfit(int &wins,int &losses,int &deals) {
    wins=0; losses=0; deals=0; MqlDateTime dt; TimeToStruct(TimeCurrent(),dt); dt.hour=0;dt.min=0;dt.sec=0;
    if(!HistorySelect(StructToTime(dt),TimeCurrent())) return 0; double total=0;
    for(int i=0;i<HistoryDealsTotal();i++){ ulong t=HistoryDealGetTicket(i); if(t==0 || HistoryDealGetInteger(t,DEAL_MAGIC)!=EA_MAGIC_NUMBER)continue; long e=HistoryDealGetInteger(t,DEAL_ENTRY); if(e!=DEAL_ENTRY_OUT&&e!=DEAL_ENTRY_OUT_BY)continue; double p=HistoryDealGetDouble(t,DEAL_PROFIT)+HistoryDealGetDouble(t,DEAL_COMMISSION)+HistoryDealGetDouble(t,DEAL_SWAP); total+=p;deals++;if(p>=0)wins++;else losses++; }
    return total;
}
void DrawTabs() {
    SetRoundedPanel("TabBar",12,50,426,39,DashPanel(),DashBorderSoft(),DashBg(),4);
    string names[]={"Trade","Strategy","Info","News/Timing","AI","Logs","Settings"}; int widths[]={54,64,48,78,38,48,60}; int x=14;
    for(int i=0;i<7;i++){
        bool active=(i==dashboard_tab);
        SetDashboardButton("TAB"+IntegerToString(i),names[i],x,54,widths[i],31,
                           active?DashAccent():DashCard(),active?DashAccent():DashSoft(),
                           active?DashOnAccent():DashMuted(),DashPanel(),2);
        x+=widths[i]+4;
    }
}
