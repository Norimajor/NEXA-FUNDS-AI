bool LicenseTradingAllowed() {
    if(!runtime_license_valid) return false;
    if(AccountInfoInteger(ACCOUNT_LOGIN)!=runtime_licensed_account) {
        runtime_license_valid=false; runtime_trading_enabled=false; runtime_new_trades_enabled=false;
        runtime_license_status="ACCOUNT CHANGED - REATTACH WITH LICENSE"; Print("[NEXA][LICENSE] ",runtime_license_status); return false;
    }
    return true;
}
bool MLPredictionFresh() {
    return runtime_ml_enabled && ml_prediction_available && GetTickCount()-ml_prediction_received_ms<=(uint)(runtime_prediction_max_age_seconds*1000);
}
bool MLProtectionValid(ENUM_ORDER_TYPE side,double entry) {
    if(!MLPredictionFresh() || !MathIsValidNumber(entry) || entry<=0 || !MathIsValidNumber(ml_stop_loss) || !MathIsValidNumber(ml_take_profit) || ml_stop_loss<=0 || ml_take_profit<=0) return false;
    double tick=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE);
    if(tick<=0 || MathAbs(ml_stop_loss/tick-MathRound(ml_stop_loss/tick))>0.000001 || MathAbs(ml_take_profit/tick-MathRound(ml_take_profit/tick))>0.000001) return false;
    double minimum=(double)SymbolInfoInteger(_Symbol,SYMBOL_TRADE_STOPS_LEVEL)*_Point;
    double bid=SymbolInfoDouble(_Symbol,SYMBOL_BID),ask=SymbolInfoDouble(_Symbol,SYMBOL_ASK);
    if(side==ORDER_TYPE_BUY) return ml_stop_loss<bid && ml_take_profit>ask && bid-ml_stop_loss>=minimum && ml_take_profit-bid>=minimum;
    return ml_stop_loss>ask && ml_take_profit<bid && ml_stop_loss-ask>=minimum && ask-ml_take_profit>=minimum;
}

