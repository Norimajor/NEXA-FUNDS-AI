void CreateDashboard() {
    if(!InpShowDashboard)return; int h=dashboard_minimized?48:540;
    SetRoundedPanel("Frame",0,0,450,h,DashBg(),DashBorder(),ChartBackground(),8);
    SetRoundedPanel("DragHandle",1,1,448,45,DashPanel(),DashBorderSoft(),DashBg(),6,true);
    SetDashboardPanel("HeaderLine",1,46,448,1,DashAccent(),DashAccent());
    SetDashboardLabel("Brand",StringFormat("NEXA AI %s",NEXA_VERSION),16,11,14,DashAccent(),FontMedium());
    bool active=runtime_trading_enabled;
    color state_color=active?DashGreen():DashRed();
    SetRoundedPanel("StatusPill",296,12,92,22,MixColor(state_color,DashPanel(),0.16),state_color,DashPanel(),3);
    SetDashboardLabel("Status",active?"ACTIVE":"STOPPED",312,16,9,state_color,FontMedium());
    SetDashboardButton("MinTop",dashboard_minimized?"+":"-",406,11,30,23,DashPanel(),DashBorder(),DashAccent(),DashPanel(),2);
    if(dashboard_minimized) {
        RoundCorners("Frame",dashboard_x,dashboard_y,DS(450),DS(h),ChartBackground(),DS(24),30);
        return;
    }
    DrawTabs();
    if(dashboard_tab==0)DrawTradeTab(); else if(dashboard_tab==1)DrawStrategyTab(); else if(dashboard_tab==2)DrawInfoTab(); else if(dashboard_tab==3)DrawNewsTab(); else if(dashboard_tab==4)DrawAITab(); else if(dashboard_tab==5)DrawLogsTab(); else DrawSettingsTab();
    SetDashboardPanel("FooterLine",14,508,422,1,DashBorderSoft(),DashBorderSoft());
    SetDashboardLabel("Footer",StringFormat("SERVER  %s  |  %s",TimeToString(TimeCurrent(),TIME_DATE),TimeToString(TimeCurrent(),TIME_SECONDS)),18,516,8,DashMuted());
    SetDashboardLabel("FooterState",MLLinkStateText(),330,516,8,MLLinkColor());
    RoundCorners("Frame",dashboard_x,dashboard_y,DS(450),DS(h),ChartBackground(),DS(24),30);
}
void RenderDashboard() { if(!InpShowDashboard)return; RemoveDashboard(); CreateDashboard(); ChartRedraw(); }
void UpdateDashboard() {
    if(!InpShowDashboard)return;
    string drag_handle=DashName("DragHandle");
    if(ObjectFind(0,drag_handle)>=0 && ObjectGetInteger(0,drag_handle,OBJPROP_SELECTED)) {
        ChartRedraw();
        return;
    }
    CreateDashboard();
    ChartRedraw();
}
void RemoveDashboard() { for(int i=ObjectsTotal(0)-1;i>=0;i--){ string n=ObjectName(0,i); if(StringFind(n,dashboard_prefix)==0)ObjectDelete(0,n); } }

//+------------------------------------------------------------------+
//| Adaptive configuration, context and structured local data       |
//+------------------------------------------------------------------+

 // Phase 2 integration point: intentionally local-only
//--- Internal staging API. Phase 2 will feed these from the ML layer; nothing external is called here.

int NormalizeHour(int hour) { while(hour<0) hour+=24; while(hour>=24) hour-=24; return hour; }
bool HourInWindow(int hour,int start_hour,int end_hour) { if(start_hour==end_hour) return true; return start_hour<end_hour ? (hour>=start_hour && hour<end_hour) : (hour>=start_hour || hour<end_hour); }
string GetCurrentSession() {
    MqlDateTime dt; TimeToStruct(TimeCurrent(),dt); int utc_hour=NormalizeHour(dt.hour-runtime_broker_utc_offset);
    bool asian=HourInWindow(utc_hour,InpAsianStartUTC,InpAsianEndUTC);
    bool london=HourInWindow(utc_hour,InpLondonStartUTC,InpLondonEndUTC);
    bool ny=HourInWindow(utc_hour,InpNewYorkStartUTC,InpNewYorkEndUTC);
    if(london && ny) return "LONDON_NEW_YORK_OVERLAP"; if(london) return "LONDON"; if(ny) return "NEW_YORK"; if(asian) return "ASIAN"; return "OTHER";
}
bool IsCurrentSessionEnabled() { string s=GetCurrentSession(); if(s=="ASIAN") return runtime_trade_asian; if(s=="LONDON") return runtime_trade_london; if(s=="NEW_YORK" || s=="LONDON_NEW_YORK_OVERLAP") return runtime_trade_new_york || runtime_trade_london; return false; }
string GetVolatilityRegime() { return "NOT_SUPPLIED_BY_ML"; }
string GetMarketRegime() { return ml_prediction_available?ml_prediction_setup_type:"UNKNOWN"; }
int DecisionScopeCode() {
    ulong hash=(ulong)AccountInfoInteger(ACCOUNT_LOGIN);
    for(int i=0;i<StringLen(_Symbol);i++) hash=(hash*31+(ulong)StringGetCharacter(_Symbol,i))%10000;
    hash=(hash*31+(ulong)_Period)%10000;
    return (int)hash;
}
string Base36Code(int value,int width) {
    const string digits="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    string code="";
    for(int i=0;i<width;i++) {
        code=StringSubstr(digits,value%36,1)+code;
        value/=36;
    }
    return code;
}
string NewDecisionId() {
    static int seq=0;
    seq=(seq+1)%46656;
    // Compact enough for the broker comment while retaining time and scope.
    return "N"+IntegerToString((int)TimeCurrent())+"-"+Base36Code(DecisionScopeCode(),3)+"-"+Base36Code(seq,3);
}
bool IsTesterRun() { return (bool)MQLInfoInteger(MQL_TESTER) || (bool)MQLInfoInteger(MQL_OPTIMIZATION) || (bool)MQLInfoInteger(MQL_VISUAL_MODE); }
string RunContext() {
    if((bool)MQLInfoInteger(MQL_OPTIMIZATION)) return "OPTIMIZATION";
    if((bool)MQLInfoInteger(MQL_TESTER) || (bool)MQLInfoInteger(MQL_VISUAL_MODE)) return "TESTER";
    return "LIVE";
}
bool DataLoggingEnabled() { if(IsTesterRun() && InpForceDataLoggingInTester) return true; return InpEnableStructuredData; }
string MLModeText() { return runtime_ml_enabled ? "ML_ON" : "ML_OFF"; }
bool IsRangingMarket() { return false; }
string RangingText() { return "NOT_SUPPLIED_BY_ML"; }
//--- ML context captured at the decision
string KeyReadings() { return StringFormat("ML_SIGNAL=%s;CONFIDENCE=%.2f;SL=%.8f;TP=%.8f;MODEL=%s",ml_prediction_signal,ml_prediction_confidence,ml_stop_loss,ml_take_profit,ml_prediction_model_version); }


//--- the tester writes to its own sandbox, so give the run a distinct file name
string DataFileName(string base) {
    string account=IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));
    string scope=account+"_"+_Symbol+"_"+EnumToString(_Period);
    if(IsTesterRun()) return "NEXA_TESTER_"+base+"_"+scope+".csv";
    return "NEXA_LIVE_"+base+"_"+scope+".csv";
}
string DataFileLockName(string base) {
    string account=IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));
    return "NEXA_LOG_LOCK_"+base+"_"+account+"_"+_Symbol+"_"+EnumToString(_Period);
}
bool AcquireDataFileLock(string base) {
    string name=DataFileLockName(base);
    if(!GlobalVariableCheck(name) && !GlobalVariableSet(name,0.0)) return false;
    double token=(double)GetTickCount()+((double)ChartID()/1000000000.0);
    for(int attempt=0;attempt<25;attempt++) {
        double current=GlobalVariableGet(name);
        if(current==0.0 && GlobalVariableSetOnCondition(name,token,0.0)) return true;
        Sleep(10);
    }
    return false;
}
void ReleaseDataFileLock(string base) {
    string name=DataFileLockName(base);
    if(GlobalVariableCheck(name)) GlobalVariableSet(name,0.0);
}
int OpenDataFile(string base) {
    string name=DataFileName(base);
    int flags=FILE_READ|FILE_WRITE|FILE_CSV|FILE_ANSI|FILE_SHARE_READ;
    if(!IsTesterRun()) flags|=FILE_COMMON;   // tester agents cannot rely on the shared folder
    int h=FileOpen(name,flags,',');
    if(h==INVALID_HANDLE && runtime_debug_logs) Print("DATA FILE ERROR ",name," err=",GetLastError());
    return h;
}
void InitializeTesterDataFiles() {
    if(!IsTesterRun() || !DataLoggingEnabled()) return;

    int decisions_handle=OpenDataFile("decisions");
    if(decisions_handle!=INVALID_HANDLE) {
        FileFlush(decisions_handle);
        FileClose(decisions_handle);
    }

    int outcomes_handle=OpenDataFile("outcomes");
    if(outcomes_handle!=INVALID_HANDLE) {
        FileFlush(outcomes_handle);
        FileClose(outcomes_handle);
    }

    int ml_handle=OpenDataFile("ml");
    if(ml_handle!=INVALID_HANDLE) {
        FileFlush(ml_handle);
        FileClose(ml_handle);
    }
}
string EscapeCsv(string v) { StringReplace(v,"\"","\"\""); return "\""+v+"\""; }
string MLDecisionSnapshot() { return KeyReadings(); }

//+------------------------------------------------------------------+
//| Additional ML-oriented dataset (LIVE and TESTER kept separate)   |
//+------------------------------------------------------------------+
string MLColumnName(string raw) {
    string v=raw; StringReplace(v," ","_"); StringReplace(v,"%","PCT"); StringReplace(v,"/","_"); StringToLower(v); return v;
}
//--- never invent data: unavailable values are written as NA
string MLNumber(double value,int digits=6) {
    if(!MathIsValidNumber(value)) return "NA";
    return DoubleToString(value,digits);
}
string MLField(string value) {
    string v=value; StringReplace(v,",",";"); StringReplace(v,"\r"," "); StringReplace(v,"\n"," ");
    if(v=="") v="NA";
    return v;
}
string MLHeaderLine() { return "timestamp,run_context,symbol,timeframe,decision_id,event,direction,source,mode,confidence,model,entry_price,stop_loss,take_profit,lot_size,failed_conditions,result,net_pl,r_multiple"; }
void WriteMLRecord(string id,string event_type,string direction,string source,double entry,double sl,double tp,double lots,
                   double bull,double bear,int confirmations,string failed,string result,double net_pl,double r_multiple,bool has_outcome) {
    if(!DataLoggingEnabled() || !AcquireDataFileLock("ml")) return;
    int h=OpenDataFile("ml"); if(h==INVALID_HANDLE) { ReleaseDataFileLock("ml"); return; }
    if(FileSize(h)==0) FileWriteString(h,MLHeaderLine()+"\r\n");
    FileSeek(h,0,SEEK_END);
    string line=MLField(TimeToString(TimeCurrent(),TIME_DATE|TIME_SECONDS))+","+RunContext()+","+MLField(_Symbol)+","+EnumToString(_Period)+","+MLField(id)+","+MLField(event_type)+","+direction+","+MLField(source)+","+active_trading_mode+","+MLNumber(ml_prediction_confidence,2)+","+MLField(ml_prediction_model_version)+","+MLNumber(entry,_Digits)+","+MLNumber(sl,_Digits)+","+MLNumber(tp,_Digits)+","+MLNumber(lots,8)+","+MLField(failed)+","+(has_outcome?MLField(result):"NA")+","+(has_outcome?MLNumber(net_pl,2):"NA")+","+(has_outcome?MLNumber(r_multiple,4):"NA");
    FileWriteString(h,line+"\r\n"); FileFlush(h); FileClose(h); ReleaseDataFileLock("ml");
}
void WriteDecisionRecord(string id,string event_type,string direction,string source,double entry,double sl,double tp,double lots,double bull,double bear,string failed,int confirmations=0) {
    if(!DataLoggingEnabled()) return;
    if(!AcquireDataFileLock("decisions")) { if(runtime_debug_logs) Print("Decision record deferred: log lock unavailable decision=",id); return; }
    int h=OpenDataFile("decisions"); if(h==INVALID_HANDLE) { ReleaseDataFileLock("decisions"); return; }
    if(FileSize(h)==0) FileWrite(h,"decision_id","event","timestamp","run_context","symbol","timeframe","session","market_state","market_regime","volatility_regime","spread_points","direction","source","decision_mode","confirmations","bull_score","bear_score","failed_conditions","entry","requested_sl","requested_tp","lots","decision_basis","ml_readings","ml_snapshot");
    FileSeek(h,0,SEEK_END);
    double spread=(SymbolInfoDouble(_Symbol,SYMBOL_ASK)-SymbolInfoDouble(_Symbol,SYMBOL_BID))/_Point;
    FileWrite(h,id,event_type,TimeToString(TimeCurrent(),TIME_DATE|TIME_SECONDS),RunContext(),_Symbol,EnumToString(_Period),
              GetCurrentSession(),RangingText(),GetMarketRegime(),GetVolatilityRegime(),spread,direction,source,MLModeText(),confirmations,
              bull,bear,failed,entry,sl,tp,lots,"ML_ONLY",KeyReadings(),MLDecisionSnapshot());
    FileFlush(h); FileClose(h); ReleaseDataFileLock("decisions");
    //--- additional ML dataset; the decision CSV above is unchanged
    WriteMLRecord(id,event_type,direction,source,entry,sl,tp,lots,bull,bear,confirmations,failed,"",0,0,false);
}
bool WriteOutcomeRecord(string decision_id,ulong ticket,double entry,double fill,double exit_price,datetime exit_time,double gross,double commission,double swap,double net,string result,double r_multiple,double mfe,double mae,string reason,string partial_info,TradeInfo &ctx,bool ctx_found) {
    if(!DataLoggingEnabled()) return false;
    if(!AcquireDataFileLock("outcomes")) { if(runtime_debug_logs) Print("Outcome deferred: log lock unavailable decision=",decision_id," position=",ticket); return false; }
    int h=OpenDataFile("outcomes");
    if(h==INVALID_HANDLE) { ReleaseDataFileLock("outcomes"); return false; }
    if(FileSize(h)==0) FileWrite(h,"decision_id","ticket","run_context","symbol","timeframe","direction","source","decision_mode","entry_session","entry_market_state","entry_market_regime","entry_volatility","entry_spread_points","confirmations","bull_score","bear_score","decision_basis_at_entry","ml_readings_at_entry","ml_snapshot_at_entry","exit_session","exit_market_state","entry_price","fill_price","exit_price","exit_time","duration_seconds","gross_pl","commission","swap","net_pl","result","r_multiple","mfe","mae","closing_reason","partial_info");
    datetime entered=ctx_found?ctx.entry_time:0;
    FileSeek(h,0,SEEK_END);
    FileWrite(h,decision_id,ticket,RunContext(),_Symbol,EnumToString(_Period),
              ctx_found?ctx.ctx_direction:"UNKNOWN",ctx_found?ctx.ctx_source:"UNKNOWN",ctx_found?ctx.ctx_mode:MLModeText(),
              ctx_found?ctx.ctx_session:GetCurrentSession(),ctx_found?ctx.ctx_ranging:RangingText(),
              ctx_found?ctx.ctx_regime:GetMarketRegime(),ctx_found?ctx.ctx_volatility:GetVolatilityRegime(),
              ctx_found?ctx.ctx_spread:0,ctx_found?ctx.ctx_confirmations:0,ctx_found?ctx.ctx_bull:0,ctx_found?ctx.ctx_bear:0,
              ctx_found?ctx.ctx_direction:"",ctx_found?ctx.ctx_key_readings:"",ctx_found?ctx.ctx_snapshot:"",
              GetCurrentSession(),RangingText(),
              entry,fill,exit_price,TimeToString(exit_time,TIME_DATE|TIME_SECONDS),(long)(exit_time-entered),
              gross,commission,swap,net,result,r_multiple,mfe,mae,reason,partial_info);
    FileFlush(h); FileClose(h); ReleaseDataFileLock("outcomes");
    //--- same decision_id links entry, trade and outcome inside the ML dataset
    WriteMLRecord(decision_id,"OUTCOME",ctx_found?ctx.ctx_direction:"UNKNOWN",ctx_found?ctx.ctx_source:"UNKNOWN",
                  entry,ctx_found?ctx.initial_stop_loss:0,ctx_found?ctx.take_profit:0,ctx_found?ctx.original_lot_size:0,
                  ctx_found?ctx.ctx_bull:0,ctx_found?ctx.ctx_bear:0,ctx_found?ctx.ctx_confirmations:0,reason,result,net,r_multiple,true);
    return true;
}
void ArchiveTrade(int index) {
    if(index<0 || index>=ArraySize(active_trades)) return;
    int n=ArraySize(closed_trades);
    if(n>=60) { for(int k=0;k<n-1;k++) closed_trades[k]=closed_trades[k+1]; n--; ArrayResize(closed_trades,n); }
    ArrayResize(closed_trades,n+1); closed_trades[n]=active_trades[index]; closed_trades[n].archived_at=TimeCurrent();
    RemoveTradeFromArray(index);
}
int CountEAOpenPositions() { int count=0; for(int i=0;i<PositionsTotal();i++){ ulong t=PositionGetTicket(i); if(t>0 && PositionGetInteger(POSITION_MAGIC)==EA_MAGIC_NUMBER && PositionGetString(POSITION_SYMBOL)==_Symbol) count++; } return count; }

string DecisionIdFromComment(string comment,ulong position_id) {
    if(StringFind(comment,"NEXA AI-")==0) {
        string id=StringSubstr(comment,8);
        if(id!="") return id;
    }
    if(StringFind(comment,"NXA-")==0) {
        string id=StringSubstr(comment,4);
        if(id!="") return id;
    }
    return "UNLINKED-"+IntegerToString((int)position_id);
}
int FindTradeByIdentity(ulong order_ticket,ulong deal_ticket,ulong position_id,string comment) {
    for(int i=0;i<ArraySize(active_trades);i++) {
        if(order_ticket>0 && active_trades[i].order_ticket==order_ticket) return i;
        if(deal_ticket>0 && active_trades[i].entry_deal_ticket==deal_ticket) return i;
        if(position_id>0 && active_trades[i].position_id==position_id) return i;
        if(comment!="" && active_trades[i].comment==comment) return i;
    }
    return -1;
}
int FindClosedTradeByIdentity(ulong position_id,ulong position_ticket) {
    for(int i=ArraySize(closed_trades)-1;i>=0;i--)
        if((position_id>0 && closed_trades[i].position_id==position_id) || (position_ticket>0 && closed_trades[i].ticket==position_ticket)) return i;
    return -1;
}
bool IsPositionStillOpen(ulong position_id,ulong position_ticket) {
    if(position_ticket>0 && PositionSelectByTicket(position_ticket)) return true;
    if(position_id==0) return false;
    for(int i=0;i<PositionsTotal();i++) {
        ulong ticket=PositionGetTicket(i);
        if(ticket>0 && (ulong)PositionGetInteger(POSITION_IDENTIFIER)==position_id) return true;
    }
    return false;
}
void RecoverOpenTrades() {
    for(int i=0;i<PositionsTotal();i++) {
        ulong ticket=PositionGetTicket(i);
        if(ticket==0 || (long)PositionGetInteger(POSITION_MAGIC)!=EA_MAGIC_NUMBER || PositionGetString(POSITION_SYMBOL)!=_Symbol) continue;
        ulong position_id=(ulong)PositionGetInteger(POSITION_IDENTIFIER);
        if(FindTradeByIdentity(0,0,position_id,"")>=0) continue;

        TradeInfo recovered;
        recovered.ticket=ticket; recovered.position_id=position_id; recovered.order_ticket=0; recovered.entry_deal_ticket=0;
        recovered.comment=PositionGetString(POSITION_COMMENT);
        recovered.decision_id=DecisionIdFromComment(recovered.comment,position_id);
        recovered.entry_price=PositionGetDouble(POSITION_PRICE_OPEN); recovered.initial_stop_loss=0;
        recovered.stop_loss=PositionGetDouble(POSITION_SL); recovered.take_profit=PositionGetDouble(POSITION_TP);
        recovered.original_lot_size=PositionGetDouble(POSITION_VOLUME); recovered.remaining_lot_size=recovered.original_lot_size;
        recovered.break_even_moved=false; recovered.trailing_active=false; recovered.tp1_hit=false; recovered.tp2_hit=false; recovered.tp3_hit=false;
        recovered.entry_time=(datetime)PositionGetInteger(POSITION_TIME); recovered.trade_type=PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY?0:1;
        recovered.mfe=0; recovered.mae=0; recovered.cumulative_gross=0; recovered.cumulative_commission=0; recovered.cumulative_swap=0;
        recovered.cumulative_net=0; recovered.realized_volume=0; recovered.cumulative_realized_move=0; recovered.partial_info="RECOVERED_AFTER_RESTART"; recovered.last_exit_time=0;
        recovered.final_closing_reason=""; recovered.outcome_written=false; recovered.archived_at=0; recovered.scalp_mode=recovered.stop_loss<=0;
        recovered.ctx_session="UNKNOWN"; recovered.ctx_regime="UNKNOWN"; recovered.ctx_ranging="UNKNOWN"; recovered.ctx_volatility="UNKNOWN";
        recovered.ctx_direction=recovered.trade_type==0?"BUY":"SELL"; recovered.ctx_source="UNKNOWN"; recovered.ctx_mode="UNKNOWN";
        recovered.ctx_snapshot=""; recovered.ctx_key_readings=""; recovered.ctx_bull=0; recovered.ctx_bear=0; recovered.ctx_confirmations=0; recovered.ctx_spread=0;

        if(HistorySelectByPosition(position_id)) {
            for(int d=0;d<HistoryDealsTotal();d++) {
                ulong deal=HistoryDealGetTicket(d);
                if(deal==0 || HistoryDealGetInteger(deal,DEAL_ENTRY)!=DEAL_ENTRY_IN) continue;
                recovered.entry_deal_ticket=deal; recovered.order_ticket=(ulong)HistoryDealGetInteger(deal,DEAL_ORDER);
                recovered.entry_price=HistoryDealGetDouble(deal,DEAL_PRICE); recovered.entry_time=(datetime)HistoryDealGetInteger(deal,DEAL_TIME);
                string deal_comment=HistoryDealGetString(deal,DEAL_COMMENT);
                if(recovered.comment=="" && deal_comment!="") recovered.comment=deal_comment;
                if(StringFind(recovered.decision_id,"UNLINKED-")==0) recovered.decision_id=DecisionIdFromComment(deal_comment,position_id);
                break;
            }
        }
        int size=ArraySize(active_trades); ArrayResize(active_trades,size+1); active_trades[size]=recovered;
    }
}


//+------------------------------------------------------------------+
//| Write EA identity and heartbeat for the MT5 sync service         |
//+------------------------------------------------------------------+
string JsonEscape(string value) {
    StringReplace(value, "\\", "\\\\");
    StringReplace(value, "\"", "\\\"");
    return value;
}

string TelemetryTimestamp(datetime timestamp) {
    string value = TimeToString(timestamp, TIME_DATE | TIME_SECONDS);
    StringReplace(value, ".", "-");
    StringReplace(value, " ", "T");
    return value + "Z";
}

bool WriteTelemetryHeartbeat(string status) {
    if(IsTesterRun()) return true;   // telemetry file is a live-trading feature
    datetime now = TimeGMT();
    if(status == "ACTIVE" && now == last_telemetry_heartbeat) return true;
    last_telemetry_heartbeat = now;

    string temporary_name = "ea_heartbeat.tmp";
    int file_handle = FileOpen(
        temporary_name,
        FILE_WRITE | FILE_TXT | FILE_ANSI | FILE_COMMON
    );
    if(file_handle == INVALID_HANDLE) {
        if(runtime_debug_logs) {
            Print("Telemetry heartbeat file error: ", GetLastError());
        }
        return false;
    }

    string ea_name = StringFormat("NEXA AI %s",NEXA_VERSION);
    string magic_number = IntegerToString(EA_MAGIC_NUMBER);
    string account_login = IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));
    string timestamp = TelemetryTimestamp(now);
    string heartbeat = StringFormat(
        "{\"instances\":[{\"name\":\"%s\",\"version\":\"%s\",\"symbol\":\"%s\",\"timeframe\":\"%s\",\"magic_number\":\"%s\",\"status\":\"%s\",\"last_heartbeat\":\"%s\",\"account_login\":\"%s\"}]}",
        JsonEscape(ea_name), EA_VERSION,
        JsonEscape(_Symbol), JsonEscape(EnumToString(_Period)),
        magic_number, status, timestamp, account_login
    );

    FileWriteString(file_handle, heartbeat);
    FileClose(file_handle);

    ResetLastError();
    if(!FileMove(temporary_name, FILE_COMMON, "ea_heartbeat.json", FILE_REWRITE)) {
        if(runtime_debug_logs) {
            Print("Telemetry heartbeat replace error: ", GetLastError());
        }
        return false;
    }

    if(runtime_debug_logs) Print("[NEXA][SNAPSHOT] ",_Symbol," ML=",ml_prediction_signal," confidence=",ml_prediction_confidence," SL=",ml_stop_loss," TP=",ml_take_profit," positions=",CountEAOpenPositions()," trades=",trades_today,"/",runtime_max_daily," UTC=",timestamp);

    return true;
}

//+------------------------------------------------------------------+
//| Real ML service connectivity check (no cosmetic status)          |
//+------------------------------------------------------------------+
string MLLinkStateText() {
    switch(ml_link_state) {
        case ML_LINK_CONNECTED:      return "ML CONNECTED";
        case ML_LINK_CONNECTING:     return "ML CONNECTING";
        case ML_LINK_UNREACHABLE:    return "ML UNREACHABLE";
        case ML_LINK_TIMEOUT:        return "ML TIMEOUT";
        case ML_LINK_HTTP_ERROR:     return "ML HTTP ERROR";
        case ML_LINK_NO_RESPONSE:    return "ML NO RESPONSE";
        case ML_LINK_NOT_PERMITTED:  return "ML URL NOT ALLOWED";
        case ML_LINK_NOT_CONFIGURED: return "ML NOT CONFIGURED";
        default:                     return "ML DISABLED";
    }
}
//--- one compact diagnostic line explaining the current state
string MLLinkDetailText() {
    if(ml_link_state==ML_LINK_DISABLED)       return ml_link_error!=""?ml_link_error:"Service check switched off";
    if(ml_link_state==ML_LINK_NOT_CONFIGURED) return "Endpoint not set";
    if(ml_link_state==ML_LINK_CONNECTED)      return ml_prediction_available?StringFormat("HTTP 200 | H1 %s | M15 %s | %s",ml_trend_direction,ml_m15_signal,ml_confirmation_status):StringFormat("HTTP 200 | %d ms",ml_link_latency_ms);
    if(ml_link_state==ML_LINK_HTTP_ERROR)     return StringFormat("HTTP %d | %s",ml_link_http_code,ml_link_error);
    if(ml_link_state==ML_LINK_TIMEOUT)        return StringFormat("Timeout after %d ms",runtime_ml_timeout_ms);
    return ml_link_error!=""?ml_link_error:"No detail available";
}
string MLLinkLastSuccessText() {
    if(ml_link_last_success<=0) return "Last success: never";
    return "Last success: "+TimeToString(ml_link_last_success,TIME_DATE|TIME_SECONDS);
}
string MLLinkLastAttemptText() {
    if(ml_link_last_attempt<=0) return "Last attempt: none";
    return "Last attempt: "+TimeToString(ml_link_last_attempt,TIME_SECONDS)+"  |  retry "+IntegerToString(MathMax(1,runtime_ml_check_seconds))+"s";
}
void AddMLDashboardLog(string message) {
    int count=ArraySize(ml_dashboard_logs);
    if(count>=32) { for(int i=0;i<count-1;i++) ml_dashboard_logs[i]=ml_dashboard_logs[i+1]; count--; ArrayResize(ml_dashboard_logs,count); }
    ArrayResize(ml_dashboard_logs,count+1);
    ml_dashboard_logs[count]=TimeToString(TimeCurrent(),TIME_SECONDS)+" | "+message;
}
void SetMLLinkState(MLLinkState state,int http_code,string detail) {
    bool changed=(ml_link_state!=state || ml_link_http_code!=http_code);
    ml_link_state=state; ml_link_http_code=http_code; ml_link_error=detail;
    if(changed) {
        AddMLDashboardLog(MLLinkStateText()+" | "+detail);
        if(runtime_debug_logs) Print("[NEXA][ML] ",MLLinkStateText()," | ",MLLinkDetailText());
    }
}
double ScalpGridSpacing(string direction) { return ml_grid_spacing; }
//--- performs a genuine request; the dashboard only ever shows this result


string MLServiceBaseUrl() {
    return ML_RENDER_BASE_URL;
}
string MLTimeframeText() {
    string value=EnumToString(_Period); StringReplace(value,"PERIOD_",""); return value;
}
string MLCandleTimestamp(datetime value) {
    MqlDateTime dt; TimeToStruct(value,dt);
    return StringFormat("%04d-%02d-%02dT%02d:%02d:%02dZ",dt.year,dt.mon,dt.day,dt.hour,dt.min,dt.sec);
}
string BuildMLCandleSeries(ENUM_TIMEFRAMES timeframe,int candle_count=500) {
    MqlRates rates[]; ArraySetAsSeries(rates,true);
    if(CopyRates(_Symbol,timeframe,1,candle_count,rates)<candle_count) return "";
    string candles="[";
    for(int i=candle_count-1;i>=0;i--) {
        if(i<candle_count-1) candles+=",";
        candles+="{\"timestamp\":\""+MLCandleTimestamp(rates[i].time-runtime_broker_utc_offset*3600)+"\",\"open\":"+DoubleToString(rates[i].open,_Digits)
                +",\"high\":"+DoubleToString(rates[i].high,_Digits)+",\"low\":"+DoubleToString(rates[i].low,_Digits)
                +",\"close\":"+DoubleToString(rates[i].close,_Digits)+",\"volume\":"+DoubleToString((double)rates[i].tick_volume,0)+"}";
    }
    return candles+"]";
}
string BuildMLCandlePayload() {
    string h1=BuildMLCandleSeries(PERIOD_H1);
    string m15=BuildMLCandleSeries(PERIOD_M15);
    if(h1=="" || m15=="") return "";
    return "{\"symbol\":\""+_Symbol+"\",\"h1_candles\":"+h1+",\"m15_candles\":"+m15+"}";
}
string MLHeaders() {
    string headers="Content-Type: application/json\r\n";
    if(StringLen(runtime_ml_api_key)>0) headers+="x-api-key: "+runtime_ml_api_key+"\r\n";
    return headers;
}
bool ExtractMLJsonString(string body,string key,string &value) {
    string needle="\""+key+"\""; int pos=StringFind(body,needle); if(pos<0 || StringFind(body,needle,pos+StringLen(needle))>=0)return false;
    int colon=StringFind(body,":",pos+StringLen(needle)); if(colon<0)return false;
    int start=colon+1; while(start<StringLen(body)&&StringGetCharacter(body,start)<=32)start++;
    if(start>=StringLen(body)||StringGetCharacter(body,start)!='"')return false;
    start++; string result="";
    for(int i=start;i<StringLen(body);i++) { ushort c=StringGetCharacter(body,i); if(c=='"') { value=result; return true; } if(c=='\\') { i++; if(i>=StringLen(body))return false; c=StringGetCharacter(body,i); if(c=='n')result+=" "; else if(c=='r')result+=" "; else if(c=='t')result+=" "; else if(c=='"'||c=='\\'||c=='/')result+=ShortToString(c); else return false; } else if(c<32)return false; else result+=ShortToString(c); }
    return false;
}
bool ExtractMLJsonNumber(string body,string key,double &value) {
    string needle="\""+key+"\""; int pos=StringFind(body,needle); if(pos<0 || StringFind(body,needle,pos+StringLen(needle))>=0)return false;
    int colon=StringFind(body,":",pos+StringLen(needle)); if(colon<0)return false;
    int start=colon+1; while(start<StringLen(body) && StringGetCharacter(body,start)<=32)start++;
    int finish=start; while(finish<StringLen(body)) { ushort c=StringGetCharacter(body,finish); if(c==',' || c=='}' || c==']' || c<=32)break; finish++; }
    string token=StringSubstr(body,start,finish-start);
    bool digit=false; int dots=0;
    for(int i=0;i<StringLen(token);i++) { ushort c=StringGetCharacter(token,i); if(c>='0'&&c<='9')digit=true; else if(c=='.'&&dots==0)dots++; else if(c=='-'&&i==0)continue; else return false; }
    if(!digit)return false; value=StringToDouble(token); return MathIsValidNumber(value);
}
bool IsGoldSymbol() {
    string symbol=_Symbol;
    StringToUpper(symbol);
    return StringFind(symbol,"XAUUSD")>=0 || StringFind(symbol,"GOLD")>=0;
}
bool IsScalpMode() { return runtime_ml_enabled && active_trading_mode=="SCALP"; }
double PipSize() { return (_Digits==3 || _Digits==5) ? _Point*10.0 : _Point; }
double ScalpPipSize() { return IsGoldSymbol()?0.10:PipSize(); }
string OperatingModeText() {
    if(runtime_operating_mode==NEXA_SWING) return "SWING";
    if(runtime_operating_mode==NEXA_SCALP) return "SCALP";
    return "AUTO";
}
bool AcceptMLPrediction(string body) {
    string signal="",model_version="",channel_bias="",setup_type="unknown",direction="NONE",signal_reason="UNKNOWN";
    string planned_direction="NONE";
    // Clear the previous result before parsing, so missing fields never reuse stale data.
    ClearMLPrediction("Parsing new ML response");
    double confidence=0,buy=0,sell=0;
    bool has_sl=ExtractMLJsonNumber(body,"stop_loss",ml_stop_loss);
    bool has_tp=ExtractMLJsonNumber(body,"take_profit",ml_take_profit);
    ExtractMLJsonNumber(body,"grid_spacing",ml_grid_spacing);
    if(!has_sl || !has_tp || ml_stop_loss<=0 || ml_take_profit<=0) {
        Print("[NEXA][ML][BLOCK] Response missing valid absolute stop_loss/take_profit prices; no fallback");
        return false;
    }
    if(!ExtractMLJsonString(body,"signal",signal) || !ExtractMLJsonString(body,"model_version",model_version)) return false;
    ExtractMLJsonString(body,"setup_type",setup_type);
    if(!ExtractMLJsonString(body,"direction",direction)) direction=(signal=="BUY"||signal=="SELL")?signal:"NONE";
    if(!ExtractMLJsonString(body,"planned_direction",planned_direction)) planned_direction=signal;
    ml_planned_direction=planned_direction;
    ExtractMLJsonString(body,"signal_reason",signal_reason);
    if(!ExtractMLJsonString(body,"channel_bias",channel_bias)) channel_bias="NONE";
    if(!ExtractMLJsonNumber(body,"confidence",confidence)) confidence=0;
    ExtractMLJsonString(body,"recommended_mode",ml_recommended_mode);
    ExtractMLJsonString(body,"trend_direction",ml_trend_direction);
    ExtractMLJsonString(body,"trend_reason",ml_trend_reason);
    ExtractMLJsonString(body,"confirmation_status",ml_confirmation_status);
    ExtractMLJsonString(body,"model_class",ml_model_class);
    ExtractMLJsonString(body,"runner_up_class",ml_runner_up_class);
    ExtractMLJsonString(body,"setup_reason",ml_setup_reason);
    ExtractMLJsonString(body,"setup_context",ml_setup_context);
    ExtractMLJsonString(body,"poi_direction",ml_poi_direction);
    ExtractMLJsonString(body,"poi_reason",ml_poi_reason);
    ExtractMLJsonString(body,"entry_direction",ml_entry_direction);
    ExtractMLJsonString(body,"entry_status",ml_entry_status);
    ExtractMLJsonString(body,"entry_zone_source",ml_entry_zone_source);
    double entry_triggered_value=0;
    ExtractMLJsonNumber(body,"entry_triggered",entry_triggered_value);
    ml_entry_triggered=entry_triggered_value>=0.5;
    ExtractMLJsonNumber(body,"entry_price",ml_entry_price);
    ExtractMLJsonNumber(body,"entry_zone_low",ml_entry_zone_low);
    ExtractMLJsonNumber(body,"entry_zone_high",ml_entry_zone_high);
    ExtractMLJsonNumber(body,"entry_candle_low",ml_entry_candle_low);
    ExtractMLJsonNumber(body,"entry_candle_high",ml_entry_candle_high);
    ExtractMLJsonString(body,"h1_signal",ml_h1_signal);
    ExtractMLJsonString(body,"m15_signal",ml_m15_signal);
    ExtractMLJsonString(body,"h1_setup_type",ml_h1_setup_type);
    ExtractMLJsonString(body,"h1_model_version",ml_h1_model_version);
    ExtractMLJsonString(body,"m15_model_version",ml_m15_model_version);
    ExtractMLJsonNumber(body,"h1_confidence",ml_h1_confidence);
    ExtractMLJsonNumber(body,"m15_confidence",ml_m15_confidence);
    ExtractMLJsonNumber(body,"model_class_probability",ml_model_class_probability);
    ExtractMLJsonNumber(body,"runner_up_probability",ml_runner_up_probability);
    bool has_buy_percent=ExtractMLJsonNumber(body,"buy",buy);
    if(!has_buy_percent && ExtractMLJsonNumber(body,"buy_probability",buy)) buy*=100.0;
    bool has_sell_percent=ExtractMLJsonNumber(body,"sell",sell);
    if(!has_sell_percent && ExtractMLJsonNumber(body,"sell_probability",sell)) sell*=100.0;
    ExtractMLJsonNumber(body,"probability_reversal",ml_probability_reversal);
    ExtractMLJsonNumber(body,"probability_continuation",ml_probability_continuation);
    ExtractMLJsonNumber(body,"probability_breakout",ml_probability_breakout);
    ExtractMLJsonNumber(body,"probability_failed_breakout",ml_probability_failed_breakout);
    ExtractMLJsonNumber(body,"probability_no_edge",ml_probability_no_edge);
    ExtractMLJsonNumber(body,"probability_reversal_buy",ml_probability_reversal_buy);
    ExtractMLJsonNumber(body,"probability_reversal_sell",ml_probability_reversal_sell);
    ExtractMLJsonNumber(body,"probability_continuation_buy",ml_probability_continuation_buy);
    ExtractMLJsonNumber(body,"probability_continuation_sell",ml_probability_continuation_sell);
    ExtractMLJsonNumber(body,"probability_breakout_buy",ml_probability_breakout_buy);
    ExtractMLJsonNumber(body,"probability_breakout_sell",ml_probability_breakout_sell);
    ExtractMLJsonNumber(body,"probability_failed_breakout_buy",ml_probability_failed_breakout_buy);
    ExtractMLJsonNumber(body,"probability_failed_breakout_sell",ml_probability_failed_breakout_sell);
    ExtractMLJsonNumber(body,"potential_bullish_reversal_low",ml_potential_bullish_reversal_low);
    ExtractMLJsonNumber(body,"potential_bullish_reversal_high",ml_potential_bullish_reversal_high);
    ExtractMLJsonNumber(body,"potential_bearish_reversal_low",ml_potential_bearish_reversal_low);
    ExtractMLJsonNumber(body,"potential_bearish_reversal_high",ml_potential_bearish_reversal_high);
    ExtractMLJsonString(body,"potential_bullish_reversal_source",ml_bullish_reversal_source);
    ExtractMLJsonString(body,"potential_bearish_reversal_source",ml_bearish_reversal_source);
    ExtractMLJsonString(body,"h1_candle_time",ml_h1_candle_time);
    ExtractMLJsonString(body,"m15_candle_time",ml_m15_candle_time);
    ExtractMLJsonNumber(body,"breakout_up",ml_breakout_up);
    ExtractMLJsonNumber(body,"breakout_down",ml_breakout_down);
    if(signal!="BUY" && signal!="SELL" && signal!="WAIT") return false;
    if(buy<0 || buy>100 || sell<0 || sell>100) return false;
    if(confidence<0 || confidence>100 || ml_h1_confidence<0 || ml_h1_confidence>100 || ml_m15_confidence<0 || ml_m15_confidence>100) return false;
    bool direction_conflict=(signal=="BUY" || signal=="SELL")?
        (direction!=signal || planned_direction!=signal):
        (direction=="BUY" || direction=="SELL" || planned_direction=="BUY" || planned_direction=="SELL");
    string selected_mode=ml_recommended_mode;
    string selected_signal="WAIT";
    bool learned_setup_confirmed=
        ml_confirmation_status=="DIRECTION_CONFIRMED" ||
        ml_confirmation_status=="REVERSAL_CONFIRMED";
    bool server_setup_valid=ml_recommended_mode=="SWING" && learned_setup_confirmed &&
        (signal=="BUY" || signal=="SELL") && direction==signal && planned_direction==signal;
    if(runtime_operating_mode==NEXA_SWING) {
        selected_mode=server_setup_valid?"SWING":"WAIT";
        selected_signal=server_setup_valid?signal:"WAIT";
        confidence=ml_m15_confidence;
        if(ml_h1_signal==ml_trend_direction && ml_h1_signal!="WAIT")
            confidence=MathMin(ml_m15_confidence,ml_h1_confidence);
    } else if(runtime_operating_mode==NEXA_SCALP) {
        selected_mode=IsGoldSymbol() && server_setup_valid?"SCALP":"WAIT";
        selected_signal=selected_mode=="SCALP"?signal:"WAIT";
        confidence=ml_m15_confidence;
        if(selected_mode=="SCALP")
            signal_reason=signal=="BUY"?"ML_SIGNAL_BUY":(signal=="SELL"?"ML_SIGNAL_SELL":"ML_NO_DIRECTIONAL_SIGNAL");
        else
            signal_reason=IsGoldSymbol()?"ML_SETUP_UNCONFIRMED":"ML_SCALP_REQUIRES_GOLD_SYMBOL";
    } else {
        double swing_confidence=ml_m15_confidence;
        if(ml_h1_signal==ml_trend_direction && ml_h1_signal!="WAIT")
            swing_confidence=MathMin(ml_m15_confidence,ml_h1_confidence);
        if(server_setup_valid) {
            selected_mode="SWING";
            selected_signal=signal;
            confidence=swing_confidence;
        } else {
            selected_mode="WAIT";
            selected_signal="WAIT";
            signal_reason="ML_SETUP_UNCONFIRMED";
        }
    }
    if(direction_conflict) {
        selected_mode="WAIT";
        selected_signal="WAIT";
        signal_reason="ML_DIRECTION_FIELDS_CONFLICT";
    }
    double scalp_confidence_required=MathMax(SCALP_MIN_ML_CONFIDENCE,runtime_ml_execution_confidence);
    if(selected_mode=="SCALP" && (selected_signal=="BUY" || selected_signal=="SELL") &&
       confidence<scalp_confidence_required)
        signal_reason=StringFormat("SCALP_CONFIDENCE_BELOW_%.0f",scalp_confidence_required);
    bool swing_setup_selected=selected_mode=="SWING" &&
        (selected_signal=="BUY" || selected_signal=="SELL");
    if(selected_mode=="SCALP") {
        if(selected_signal=="BUY" || selected_signal=="SELL") {
            bool buy_side=selected_signal=="BUY";
            double fallback_low=buy_side?ml_potential_bullish_reversal_low:ml_potential_bearish_reversal_low;
            double fallback_high=buy_side?ml_potential_bullish_reversal_high:ml_potential_bearish_reversal_high;
            if(ml_entry_zone_low<=0 || ml_entry_zone_high<ml_entry_zone_low) {
                ml_entry_zone_low=fallback_low;
                ml_entry_zone_high=fallback_high;
                ml_entry_price=(fallback_low>0 && fallback_high>=fallback_low)?(fallback_low+fallback_high)*0.5:0;
                ml_entry_zone_source=buy_side?ml_bullish_reversal_source:ml_bearish_reversal_source;
            }
            bool valid_scalp_zone=ml_entry_zone_low>0 && ml_entry_zone_high>=ml_entry_zone_low;
            bool valid_scalp_candle=ml_entry_candle_low>0 && ml_entry_candle_high>=ml_entry_candle_low;
            ml_entry_triggered=valid_scalp_zone && valid_scalp_candle &&
                ml_entry_candle_low<=ml_entry_zone_high && ml_entry_candle_high>=ml_entry_zone_low;
            ml_planned_direction=selected_signal;
            ml_entry_direction=ml_entry_triggered?selected_signal:"WAIT";
            ml_entry_status=ml_entry_triggered?"ZONE_TOUCHED":valid_scalp_zone?"WAIT_FOR_ZONE":"NO_ENTRY_ZONE";
        } else {
            ml_planned_direction="WAIT";
            ml_entry_direction="WAIT";
            ml_entry_triggered=false;
            ml_entry_status="NO_DIRECTIONAL_EDGE";
        }
    } else if(swing_setup_selected) {
        ml_planned_direction=selected_signal;
    } else {
        selected_signal="WAIT";
    }
    if(selected_mode!="SWING" && selected_mode!="SCALP") selected_mode="WAIT";
    bool live_zone_touch=MLCurrentPriceInsideEntryZone();
    if(live_zone_touch) {
        ml_entry_triggered=true;
        ml_entry_direction=ml_planned_direction;
        ml_entry_status="ZONE_TOUCHED";
    }
    bool scalp_direction_selected=selected_mode=="SCALP" &&
        (selected_signal=="BUY" || selected_signal=="SELL");
    bool scalp_confidence_met=confidence>=scalp_confidence_required;
    bool existing_scalp_grid=selected_mode=="SCALP" && CountEAOpenPositions()>0;
    bool entry_level_ready=live_zone_touch || existing_scalp_grid;
    string execution_signal=(selected_signal=="BUY"||selected_signal=="SELL") &&
        ((scalp_direction_selected && scalp_confidence_met && entry_level_ready) ||
         (selected_mode=="SWING" && live_zone_touch))?
        selected_signal:"WAIT";
    if(selected_signal!="BUY" && selected_signal!="SELL") selected_mode="WAIT";
    active_trading_mode=selected_mode;
    ml_prediction_signal=execution_signal; ml_prediction_setup_type=setup_type; ml_prediction_direction=direction;
    ml_prediction_reason=signal_reason;
    ml_prediction_model_version=model_version; ml_prediction_confidence=confidence;
    ml_prediction_buy_probability=buy; ml_prediction_sell_probability=sell; ml_prediction_time=TimeCurrent();
    ml_prediction_available=true; ml_prediction_received_ms=GetTickCount();
    DrawMLPointOfInterest();
    AddMLDashboardLog(StringFormat("MODEL %s %.3f > %s %.3f",
        ml_model_class,ml_model_class_probability,ml_runner_up_class,ml_runner_up_probability));
    AddMLDashboardLog("WHY "+ml_setup_reason);
    AddMLDashboardLog("CONTEXT "+ml_setup_context);
    AddMLDashboardLog("H1 TREND "+ml_trend_reason);
    AddMLDashboardLog("POI "+ml_poi_reason);
    AddMLDashboardLog(StringFormat("ENTRY %s %s | %s | zone %.5f-%.5f | candle %.5f-%.5f",
        ml_planned_direction,ml_entry_status,ml_entry_triggered?"TOUCHED":"WAIT",
        ml_entry_zone_low,ml_entry_zone_high,ml_entry_candle_low,ml_entry_candle_high));
    if(runtime_decision_logs)
          Print("[NEXA][ML] symbol=",_Symbol," H1 bias=",ml_trend_direction," (",ml_h1_setup_type,")",
              " | M15=",setup_type,"/",ml_m15_signal," confidence=",DoubleToString(confidence,1),
              " | confirmation=",ml_confirmation_status," | EA=",execution_signal,
              " reason=",signal_reason," | model=",model_version);
    if(runtime_decision_logs)
        Print("[NEXA][ML][WHY] H1 evidence=",ml_trend_reason," | top class=",ml_model_class,
            " score=",DoubleToString(ml_model_class_probability,3)," runner-up=",ml_runner_up_class,
            " score=",DoubleToString(ml_runner_up_probability,3)," | context=",ml_setup_context,
            " | POI=",ml_poi_reason);
    if(runtime_decision_logs && ml_potential_bullish_reversal_high>0)
        Print("[NEXA][ML] potential bullish reversal reference=",DoubleToString(ml_potential_bullish_reversal_low,_Digits),"-",DoubleToString(ml_potential_bullish_reversal_high,_Digits)," source=",ml_bullish_reversal_source);
    if(runtime_decision_logs && ml_potential_bearish_reversal_high>0)
        Print("[NEXA][ML] potential bearish reversal reference=",DoubleToString(ml_potential_bearish_reversal_low,_Digits),"-",DoubleToString(ml_potential_bearish_reversal_high,_Digits)," source=",ml_bearish_reversal_source);
    if(runtime_decision_logs && (ml_breakout_up>0 || ml_breakout_down>0))
        Print("[NEXA][ML] breakout reference high=",DoubleToString(ml_breakout_up,_Digits)," low=",DoubleToString(ml_breakout_down,_Digits));
    if(runtime_decision_logs)
        Print("[NEXA][ML][ENTRY] status=",ml_entry_status," planned=",ml_planned_direction,
            " entry_direction=",ml_entry_direction,
            " triggered=",ml_entry_triggered," zone=",DoubleToString(ml_entry_zone_low,_Digits),"-",
            DoubleToString(ml_entry_zone_high,_Digits)," level=",DoubleToString(ml_entry_price,_Digits),
            " source=",ml_entry_zone_source," candle=",DoubleToString(ml_entry_candle_low,_Digits),"-",
            DoubleToString(ml_entry_candle_high,_Digits)," execution=",execution_signal);
    Print("[NEXA][ML][OBS] model=",model_version," H1 bias=",ml_trend_direction,
        " M15 setup=",setup_type,"/",ml_m15_signal,
        " confidence=",DoubleToString(confidence,1),"% confirmation=",ml_confirmation_status,
        " planned=",ml_planned_direction,
        " entry=",ml_entry_status," zone=",DoubleToString(ml_entry_zone_low,_Digits),"-",
        DoubleToString(ml_entry_zone_high,_Digits)," candle=",DoubleToString(ml_entry_candle_low,_Digits),"-",
        DoubleToString(ml_entry_candle_high,_Digits)," triggered=",ml_entry_triggered,
        " EA=",execution_signal);
    return true;
}
bool RequestMLPrediction() {
    if(!InpUseMLService || IsTesterRun()) return false;
    string base=MLServiceBaseUrl(); if(StringLen(base)<8) { SetMLLinkState(ML_LINK_NOT_CONFIGURED,0,"ML API base URL not set"); return false; }
    string body=BuildMLCandlePayload(); if(body=="") { SetMLLinkState(ML_LINK_NO_RESPONSE,0,"Fewer than 500 completed H1 or M15 candles available"); return false; }
    char request[]; char response[]; string response_headers=""; string headers=MLHeaders();
    StringToCharArray(body,request,0,StringLen(body),CP_UTF8); ResetLastError(); uint started=GetTickCount();
    int status=WebRequest("POST",base+"/api/ml/predict/consensus",headers,MathMax(500,runtime_ml_timeout_ms),request,response,response_headers);
    int error_code=GetLastError(); int elapsed=(int)(GetTickCount()-started);
    if(status==-1) { SetMLLinkState(error_code==4014?ML_LINK_NOT_PERMITTED:(error_code==5202?ML_LINK_TIMEOUT:ML_LINK_UNREACHABLE),0,StringFormat("Request error %d; allow %s in MT5 Expert Advisor options",error_code,ML_RENDER_BASE_URL)); return false; }
    if(status<200 || status>=300) {
        string detail=status>0?CharArrayToString(response,0,MathMin(160,ArraySize(response))):StringFormat("request error %d",error_code);
        SetMLLinkState(ML_LINK_HTTP_ERROR,status,detail); return false;
    }
    string prediction_body=CharArrayToString(response,0,ArraySize(response));
    if(!AcceptMLPrediction(prediction_body)) { SetMLLinkState(ML_LINK_HTTP_ERROR,status,"Invalid ML prediction response"); return false; }
    ml_link_latency_ms=elapsed; ml_link_last_success=TimeCurrent();     SetMLLinkState(ML_LINK_CONNECTED,status,StringFormat("HTTP %d | %d ms | H1 %s | M15 %s | %s",
        status,elapsed,ml_trend_direction,ml_m15_signal,ml_confirmation_status));
    return true;
}
void ClearMLPrediction(string reason) {
    bool had_prediction=ml_prediction_available;
    ml_prediction_available=false;
    ml_prediction_signal="WAIT"; ml_prediction_setup_type="no_model"; ml_prediction_direction="NONE";
    ml_prediction_model_version="NO_MODEL"; ml_prediction_reason=reason; ml_prediction_confidence=0;
    ml_prediction_buy_probability=0; ml_prediction_sell_probability=0; ml_prediction_time=0;
    ml_h1_confidence=0; ml_m15_confidence=0; ml_stop_loss=0; ml_take_profit=0; ml_grid_spacing=0;
    ml_recommended_mode="WAIT"; ml_h1_signal="WAIT"; ml_m15_signal="WAIT"; ml_h1_setup_type="unknown";
    ml_trend_direction="NONE"; ml_confirmation_status="NO_TREND_DIRECTION";
    ml_h1_model_version="unknown"; ml_m15_model_version="unknown"; active_trading_mode="WAIT";
    ml_probability_reversal=0; ml_probability_continuation=0; ml_probability_breakout=0;
    ml_probability_failed_breakout=0; ml_probability_no_edge=0;
    ml_probability_reversal_buy=0; ml_probability_reversal_sell=0;
    ml_probability_continuation_buy=0; ml_probability_continuation_sell=0;
    ml_probability_breakout_buy=0; ml_probability_breakout_sell=0;
    ml_probability_failed_breakout_buy=0; ml_probability_failed_breakout_sell=0;
    ml_potential_bullish_reversal_low=0; ml_potential_bullish_reversal_high=0;
    ml_potential_bearish_reversal_low=0; ml_potential_bearish_reversal_high=0;
    ml_entry_direction="WAIT"; ml_planned_direction="WAIT"; ml_entry_status=reason; ml_entry_zone_source="unavailable";
    ml_poi_direction="NONE"; ml_setup_reason=reason; ml_setup_context="No current M15 setup context";
    ml_poi_reason="No structural POI"; ml_trend_reason=reason;
    ml_model_class="unknown"; ml_runner_up_class="unknown";
    ml_model_class_probability=0; ml_runner_up_probability=0;
    ml_entry_triggered=false; ml_entry_price=0; ml_entry_zone_low=0; ml_entry_zone_high=0;
    ml_entry_candle_low=0; ml_entry_candle_high=0;
    ml_breakout_up=0; ml_breakout_down=0;
    ml_bullish_reversal_source="unavailable"; ml_bearish_reversal_source="unavailable";
    ml_h1_candle_time=""; ml_m15_candle_time="";
    RemoveMLPointOfInterest();
    if(had_prediction) AddMLDashboardLog("Prediction cleared: "+reason);
}
bool UpdateMLPrediction() {
    if(!LicenseTradingAllowed() || !runtime_ml_enabled || !InpUseMLService || IsTesterRun()) {
        ClearMLPrediction("ML inference disabled or unavailable");
        return false;
    }
    if(ml_inference_in_progress) return false;
    datetime now=TimeLocal();
    if(last_ml_inference_attempt>0 && now-last_ml_inference_attempt<MathMax(1,runtime_ml_check_seconds)) return false;
    last_ml_inference_attempt=now;
    ml_inference_in_progress=true;
    bool success=RequestMLPrediction();
    ml_inference_in_progress=false;
    if(!success) ClearMLPrediction("Latest ML request failed; waiting for fresh prediction");
    return success;
}

//+------------------------------------------------------------------+
//| Runtime controls, calendar filter and diagnostics                |
//+------------------------------------------------------------------+
double NormalizeVolume(double volume) {
    double minv=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN),maxv=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX),step=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);
    if(step<=0)step=minv; volume=MathMax(minv,MathMin(maxv,volume)); volume=MathFloor(volume/step+0.0000001)*step;
    int digits=0; double probe=step; while(digits<8 && MathAbs(probe-MathRound(probe))>0.0000001){probe*=10.0;digits++;} return NormalizeDouble(volume,digits);
}

bool IsNewsBlocked() {
    if(!runtime_use_news)return false;
    if(IsTesterRun())return true; string base=SymbolInfoString(_Symbol,SYMBOL_CURRENCY_BASE),quote=SymbolInfoString(_Symbol,SYMBOL_CURRENCY_PROFIT);
    datetime from=TimeCurrent()-runtime_news_minutes*60,to=TimeCurrent()+runtime_news_minutes*60; MqlCalendarValue values[]; int count=CalendarValueHistory(values,from,to,NULL,NULL);
    if(count<0) { Print("[NEXA][NEWS] Calendar unavailable; entries blocked"); return true; }
    if(count==0)return false;
    for(int i=0;i<count;i++){ MqlCalendarEvent event; if(!CalendarEventById(values[i].event_id,event))continue; MqlCalendarCountry country; if(!CalendarCountryById(event.country_id,country))continue; if(event.importance==CALENDAR_IMPORTANCE_HIGH && (country.currency==base || country.currency==quote))return true; }
    return false;
}
void CloseAllEAPositions() {
    int requested=0,closed=0; for(int i=PositionsTotal()-1;i>=0;i--){ ulong ticket=PositionGetTicket(i); if(ticket==0)continue; if((long)PositionGetInteger(POSITION_MAGIC)!=EA_MAGIC_NUMBER || PositionGetString(POSITION_SYMBOL)!=_Symbol)continue; requested++; if(trade.PositionClose(ticket)){closed++;Print("[NEXA] Closed EA position #",ticket);}else Print("[NEXA][ERROR] Close failed #",ticket," retcode=",trade.ResultRetcode()," ",trade.ResultRetcodeDescription()); }
    Print("[NEXA] Stop command complete: ",closed,"/",requested," EA positions closed on ",_Symbol);
}
void PrintRuntimeSettings(string reason) {
    Print("[NEXA] ",reason," version=",EA_VERSION," symbol=",_Symbol," license=",runtime_license_status);
    Print("[NEXA] trade=",DashboardBool(runtime_trading_enabled)," ML=",DashboardBool(runtime_ml_enabled)," mode=",OperatingModeText()," risk=",runtime_risk_percentage,"% lot=",runtime_fixed_lot);
    Print("[NEXA] daily=",runtime_max_daily," hourly=",runtime_max_hourly," positions=",runtime_max_positions," scalp positions=",runtime_scalp_max_positions," interval minutes=",runtime_min_trade_minutes," refresh ms=",runtime_refresh_ms);
}

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit() {
    trade.SetExpertMagicNumber(EA_MAGIC_NUMBER); trade.SetDeviationInPoints(10); trade.SetTypeFillingBySymbol(_Symbol);
    ArrayResize(active_trades,0); ArrayResize(closed_trades,0);
    runtime_licensed_account=AccountInfoInteger(ACCOUNT_LOGIN);
    runtime_license_valid=LicenseValidate(InpLicenseKey,runtime_licensed_account,runtime_license_status);
    if(!runtime_license_valid) { runtime_trading_enabled=false; runtime_new_trades_enabled=false; }
    // Local provisioning avoids shipping service credentials in source or MT5 Inputs.
    int keyfile=FileOpen("NEXA_ML_API_KEY.txt",FILE_READ|FILE_TXT|FILE_ANSI);
    if(keyfile!=INVALID_HANDLE) { runtime_ml_api_key=FileReadString(keyfile); FileClose(keyfile); StringTrimLeft(runtime_ml_api_key); StringTrimRight(runtime_ml_api_key); }
    ResetCounters(); RecoverOpenTrades(); InitializeTesterDataFiles();
    SetMLLinkState(IsTesterRun()?ML_LINK_DISABLED:ML_LINK_NOT_CONFIGURED,0,IsTesterRun()?"WebRequest unavailable in Strategy Tester":"Awaiting prediction request");
    CreateDashboard();
    if(!EventSetMillisecondTimer(50)) { Print("[NEXA][ERROR] Dashboard timer failed: ",GetLastError()); return INIT_FAILED; }
    PrintRuntimeSettings("INITIALIZED");
    Print("[NEXA][LICENSE] ",runtime_license_status," | account=",runtime_licensed_account);
    Print("[NEXA] Data files: ",DataFileName("decisions"),", ",DataFileName("outcomes"),", ",DataFileName("ml"));
    Print("[NEXA] Dashboard refresh=",runtime_refresh_ms,"ms; synchronous ML timeout=",runtime_ml_timeout_ms,"ms");
    if(runtime_ml_api_key=="") Print("[NEXA][ML] No local API credential supplied; protected endpoints may reject requests");
    return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Expert deinitialization function                               |
//+------------------------------------------------------------------+

void OnDeinit(const int reason) {
    EventKillTimer(); WriteTelemetryHeartbeat("STOPPED"); RemoveDashboard(); RemoveMLPointOfInterest();
    Print("[NEXA] Stopped; reason=",reason);
}

//+------------------------------------------------------------------+
//| Expert tick function                                           |
//+------------------------------------------------------------------+
void OnTick() {
    UpdateCounters();
    if(!LicenseTradingAllowed()) return;
    ManageExistingTrades();
    if(!IsTradeAllowed()) return;
    ActivateMLLiveZoneEntry();
    if(ShouldLookForNewTrades()) ScanForTradingOpportunities();
}

//+------------------------------------------------------------------+
//| Check if trading is allowed                                   |
//+------------------------------------------------------------------+
bool IsTradeAllowed() {
    if(!runtime_trading_enabled || !LicenseTradingAllowed() || !MLPredictionFresh()) return false;

    // Check terminal and account permissions
    if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) || !MQLInfoInteger(MQL_TRADE_ALLOWED)) {
        return false;
    }
    
    // Check daily trade limit
    if(trades_today >= runtime_max_daily) {
        if(runtime_decision_logs) Print("[BLOCK] Daily trade limit reached: ", trades_today);
        return false;
    }
    
    // Check hourly trade limit
    if(trades_this_hour >= runtime_max_hourly) {
        if(runtime_decision_logs) Print("[BLOCK] Hourly trade limit reached: ", trades_this_hour);
        return false;
    }
    
    // Check session filter
    if(runtime_use_session && !IsWithinTradingSession()) {
        return false;
    }
    
    // Check spread filter
    if(runtime_spread_filter && !IsSpreadAcceptable()) {
        return false;
    }
    
    // Check time between trades
    if(runtime_use_news && IsNewsBlocked()) { if(runtime_decision_logs) Print("[BLOCK] High-impact news window active"); return false; }
    if(TimeCurrent() - last_trade_time < runtime_min_trade_minutes * 60) {
        if(runtime_decision_logs) Print("[BLOCK] Too soon since last trade");
        return false;
    }
    
    return true;
}

//+------------------------------------------------------------------+
//| Check if within trading session                               |
//+------------------------------------------------------------------+
bool IsWithinTradingSession() {
    MqlDateTime dt; TimeToStruct(TimeCurrent(),dt);
    bool generic=HourInWindow(dt.hour,runtime_session_start,runtime_session_end);
    bool named=IsCurrentSessionEnabled();
    if(!generic || !named){ if(runtime_decision_logs) Print("Outside configured session: ",GetCurrentSession()," broker hour ",dt.hour); return false; }
    return true;
}

//+------------------------------------------------------------------+
//| Check if spread is acceptable                                 |
//+------------------------------------------------------------------+
bool IsSpreadAcceptable() {
    double spread = (SymbolInfoDouble(_Symbol, SYMBOL_ASK) - SymbolInfoDouble(_Symbol, SYMBOL_BID)) / PipSize();
    
    if(spread > runtime_max_spread_pips) {
        if(runtime_decision_logs) {
            Print("[BLOCK] Spread too high: ", DoubleToString(spread, 1), " pips");
        }
        return false;
    }
    
    return true;
}

//+------------------------------------------------------------------+
//| Should look for new trades                                    |
//+------------------------------------------------------------------+
bool ShouldLookForNewTrades() {
    if(!runtime_new_trades_enabled || !MLPredictionFresh()) return false;
    if(!runtime_ml_enabled) return false;
    if(runtime_ml_enabled && active_trading_mode!="SWING" && active_trading_mode!="SCALP") return false;
    int position_limit=IsScalpMode()?runtime_scalp_max_positions:runtime_max_positions;
    if(CountEAOpenPositions()>=position_limit){ if(runtime_decision_logs)Print("EA position limit reached: ",position_limit); return false; }
    if(!MLCurrentPriceInsideEntryZone()) {
        if(runtime_decision_logs && ml_entry_triggered)
            Print("[NEXA][ML][ENTRY] candle touched zone but executable quote is outside it; waiting for a live zone touch");
        return false;
    }
    if(IsScalpMode()) {
        if(!IsGoldSymbol()) return false;
        if(!GridAddIsDue(ml_prediction_signal)) return false;
    }
    return true;
}
bool GridAddIsDue(string direction) {
    if(direction!="BUY" && direction!="SELL") return false;
    bool found=false; double anchor=0;
    for(int i=0;i<PositionsTotal();i++) {
        ulong ticket=PositionGetTicket(i);
        if(ticket==0 || (long)PositionGetInteger(POSITION_MAGIC)!=EA_MAGIC_NUMBER || PositionGetString(POSITION_SYMBOL)!=_Symbol) continue;
        long type=PositionGetInteger(POSITION_TYPE);
        if((direction=="BUY" && type!=POSITION_TYPE_BUY) || (direction=="SELL" && type!=POSITION_TYPE_SELL)) return false;
        double entry=PositionGetDouble(POSITION_PRICE_OPEN);
        if(!found) anchor=entry;
        else anchor=direction=="BUY"?MathMin(anchor,entry):MathMax(anchor,entry);
        found=true;
    }
    if(!found) return true;
    double spacing=ScalpGridSpacing(direction);
    if(!MathIsValidNumber(spacing) || spacing<=0) return false;
    double market_price=direction=="BUY"?SymbolInfoDouble(_Symbol,SYMBOL_BID):SymbolInfoDouble(_Symbol,SYMBOL_ASK);
    return direction=="BUY"?market_price<=anchor-spacing:market_price>=anchor+spacing;
}
bool MLCurrentPriceInsideEntryZone() {
    if(ml_entry_zone_low<=0 || ml_entry_zone_high<ml_entry_zone_low) return false;
    if(ml_planned_direction!="BUY" && ml_planned_direction!="SELL") return false;
    double executable_price=ml_planned_direction=="BUY"?SymbolInfoDouble(_Symbol,SYMBOL_ASK):
        SymbolInfoDouble(_Symbol,SYMBOL_BID);
    return executable_price>=ml_entry_zone_low && executable_price<=ml_entry_zone_high;
}
bool ActivateMLLiveZoneEntry() {
    if(!runtime_ml_enabled || !MLPredictionFresh() ||
       (active_trading_mode!="SWING" && active_trading_mode!="SCALP"))
        return false;
    if((ml_planned_direction!="BUY" && ml_planned_direction!="SELL") ||
       ml_prediction_direction!=ml_planned_direction)
        return false;
    if(ml_confirmation_status!="DIRECTION_CONFIRMED" &&
       ml_confirmation_status!="REVERSAL_CONFIRMED")
        return false;
    if(active_trading_mode=="SCALP" &&
       ml_prediction_confidence<MathMax(SCALP_MIN_ML_CONFIDENCE,runtime_ml_execution_confidence))
        return false;
    if((ml_planned_direction=="BUY" && !runtime_buy_enabled) ||
       (ml_planned_direction=="SELL" && !runtime_sell_enabled))
        return false;
    if(!MLCurrentPriceInsideEntryZone()) return false;
    ml_entry_triggered=true;
    ml_entry_direction=ml_planned_direction;
    ml_entry_status="ZONE_TOUCHED";
    if(ml_prediction_signal=="WAIT") {
        ml_prediction_signal=ml_planned_direction;
        ml_prediction_reason="LIVE_POI_ZONE_TOUCHED";
        if(runtime_decision_logs)
            Print("[NEXA][ML][ENTRY] LIVE ZONE TOUCH | direction=",ml_planned_direction,
                " quote=",DoubleToString(ml_planned_direction=="BUY"?SymbolInfoDouble(_Symbol,SYMBOL_ASK):SymbolInfoDouble(_Symbol,SYMBOL_BID),_Digits),
                " zone=",DoubleToString(ml_entry_zone_low,_Digits),"-",DoubleToString(ml_entry_zone_high,_Digits),
                " | executing without waiting for next bar");
        AddMLDashboardLog(StringFormat("LIVE ZONE TOUCH %s @ %s | zone %s-%s",
            ml_planned_direction,
            DoubleToString(ml_planned_direction=="BUY"?SymbolInfoDouble(_Symbol,SYMBOL_ASK):SymbolInfoDouble(_Symbol,SYMBOL_BID),_Digits),
            DoubleToString(ml_entry_zone_low,_Digits),DoubleToString(ml_entry_zone_high,_Digits)));
    }
    return true;
}
string ModeReadinessText() {
    if(!LicenseTradingAllowed()) return "BLOCKED  |  "+runtime_license_status;
    if(!runtime_trading_enabled) return "PENDING  |  trading is stopped";
    if(!MLPredictionFresh()) return "PENDING  |  no fresh ML prediction";
    ENUM_ORDER_TYPE side=ml_planned_direction=="BUY"?ORDER_TYPE_BUY:ORDER_TYPE_SELL;
    double quote=SymbolInfoDouble(_Symbol,side==ORDER_TYPE_BUY?SYMBOL_ASK:SYMBOL_BID);
    if(!MLProtectionValid(side,quote)) return "PENDING  |  ML stop_loss/take_profit invalid for live quote";
    if(!runtime_new_trades_enabled) return "PENDING  |  new trades are disabled";
    if(!runtime_ml_enabled || !InpUseMLService) return "PENDING  |  NEXA ML is unavailable";
    if(!ml_prediction_available) return "PENDING  |  waiting for a fresh ML prediction";
    if(active_trading_mode!="SWING" && active_trading_mode!="SCALP")
        return "PENDING  |  "+(ml_prediction_reason!=""?ml_prediction_reason:"no valid ML setup");
    if(active_trading_mode=="SCALP" &&
       ml_prediction_confidence<MathMax(SCALP_MIN_ML_CONFIDENCE,runtime_ml_execution_confidence))
        return StringFormat("PENDING  |  scalp confidence %.1f%% below %.0f%% minimum",
            ml_prediction_confidence,MathMax(SCALP_MIN_ML_CONFIDENCE,runtime_ml_execution_confidence));
    if(!MLCurrentPriceInsideEntryZone()) {
        string entry_wait=ml_entry_triggered?"candle touched; live quote outside zone":ml_entry_status;
        return "PENDING  |  ML "+entry_wait+" "+
            DoubleToString(ml_entry_zone_low,_Digits)+"-"+DoubleToString(ml_entry_zone_high,_Digits);
    }
    if((ml_prediction_signal=="BUY" && !runtime_buy_enabled) || (ml_prediction_signal=="SELL" && !runtime_sell_enabled))
        return "PENDING  |  selected direction is disabled";
    if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) || !MQLInfoInteger(MQL_TRADE_ALLOWED)) return "PENDING  |  terminal/account trading permission";
    if(trades_today>=runtime_max_daily) return "PENDING  |  daily trade limit reached";
    if(trades_this_hour>=runtime_max_hourly) return "PENDING  |  hourly trade limit reached";
    if(TimeCurrent()-last_trade_time<runtime_min_trade_minutes*60) return "PENDING  |  minimum trade interval";
    if(runtime_use_session) {
        MqlDateTime session_time; TimeToStruct(TimeCurrent(),session_time);
        if(!HourInWindow(session_time.hour,runtime_session_start,runtime_session_end) || !IsCurrentSessionEnabled())
            return "PENDING  |  outside enabled session";
    }
    double current_spread=(SymbolInfoDouble(_Symbol,SYMBOL_ASK)-SymbolInfoDouble(_Symbol,SYMBOL_BID))/PipSize();
    if(runtime_spread_filter && current_spread>runtime_max_spread_pips) return "PENDING  |  spread filter";
    if(runtime_use_news && IsNewsBlocked()) return "PENDING  |  high-impact news window";
    if(active_trading_mode=="SWING") {
        if(CountEAOpenPositions()>=runtime_max_positions) return "PENDING  |  swing position limit reached";
        return "READY  |  H1/M15 confirmed; ML protective prices accepted";
    }
    if(!IsGoldSymbol()) return "PENDING  |  scalp is restricted to XAUUSD";
    if(CountEAOpenPositions()>=runtime_scalp_max_positions) return "PENDING  |  scalp position limit reached";
    if(!GridAddIsDue(ml_prediction_signal))
        return StringFormat("PENDING  |  waiting for %s ML add interval %.2f",
            ml_prediction_signal,ScalpGridSpacing(ml_prediction_signal));
    return "READY  |  ML quote, spacing and protective prices accepted";
}

//+------------------------------------------------------------------+
//| Scan for trading opportunities                                |
//+------------------------------------------------------------------+
void ScanForTradingOpportunities() { CheckForHighProbabilitySetups(); }

//+------------------------------------------------------------------+
//| Check for high probability setups                            |
//+------------------------------------------------------------------+
void StageDecisionContext(string direction,string source,double bull,double bear,int confirmations) {
    stage_session=GetCurrentSession(); stage_regime=GetMarketRegime(); stage_ranging=RangingText();
    stage_volatility=GetVolatilityRegime(); stage_direction=direction; stage_source=source; stage_mode=OperatingModeText()+"_"+active_trading_mode+"_"+MLModeText();
    stage_snapshot=MLDecisionSnapshot(); stage_key_readings=KeyReadings();
    stage_bull=bull; stage_bear=bear; stage_confirmations=confirmations;
    stage_spread=(SymbolInfoDouble(_Symbol,SYMBOL_ASK)-SymbolInfoDouble(_Symbol,SYMBOL_BID))/_Point;
}

void CheckForHighProbabilitySetups() {
    if(!runtime_ml_enabled || !MLPredictionFresh()) return;
    string side=ml_prediction_signal;
    if(side!="BUY" && side!="SELL") return;
    if((side=="BUY"&&!runtime_buy_enabled)||(side=="SELL"&&!runtime_sell_enabled)) return;
    pending_decision_id=NewDecisionId();
    StageDecisionContext(side,"ML_ONLY",ml_prediction_buy_probability,ml_prediction_sell_probability,0);
    ExecuteHighProbabilityTrade(side=="BUY"?ORDER_TYPE_BUY:ORDER_TYPE_SELL,0,"ML_ONLY");
}

//+------------------------------------------------------------------+
//| Execute high probability trade                                |
//+------------------------------------------------------------------+
void ExecuteHighProbabilityTrade(ENUM_ORDER_TYPE trade_type,int signal_strength,string trade_source) {
    if(!LicenseTradingAllowed() || !IsTradeAllowed() || !ShouldLookForNewTrades() || !runtime_ml_enabled) return;
    if((trade_type==ORDER_TYPE_BUY&&!runtime_buy_enabled)||(trade_type==ORDER_TYPE_SELL&&!runtime_sell_enabled)||!runtime_new_trades_enabled)return;
    if(runtime_ml_enabled) {
        string requested_side=trade_type==ORDER_TYPE_BUY?"BUY":"SELL";
        if(!ml_prediction_available || ml_prediction_signal!=requested_side ||
           ml_prediction_direction!=requested_side || ml_planned_direction!=requested_side) {
            Print("[NEXA][ERROR] Blocked ML direction mismatch | requested=",requested_side,
                " signal=",ml_prediction_signal," direction=",ml_prediction_direction,
                " planned=",ml_planned_direction," source=",trade_source);
            return;
        }
    }
    double entry_price=trade_type==ORDER_TYPE_BUY?SymbolInfoDouble(_Symbol,SYMBOL_ASK):SymbolInfoDouble(_Symbol,SYMBOL_BID),stop_loss=0,take_profit=0;
    if(!MLProtectionValid(trade_type,entry_price)) { Print("[NEXA][BLOCK] Invalid/missing ML protective prices; no fallback"); return; }
    CalculateStopLossAndTakeProfit(trade_type,entry_price,stop_loss,take_profit);
    double lot_size=CalculateLotSize(entry_price,stop_loss);
    if(lot_size<=0||stop_loss<=0||take_profit<=0){ Print("Invalid order parameters for ",active_trading_mode," mode"); return; }
    if(pending_decision_id=="") pending_decision_id=NewDecisionId();
    string comment="NEXA AI-"+pending_decision_id;
    if(StringLen(comment)>31) {
        Print("[NEXA][ERROR] Generated trade comment exceeds the 31-character broker limit.");
        return;
    }
    if(stage_direction=="" || stage_direction!=(trade_type==ORDER_TYPE_BUY?"BUY":"SELL"))
        StageDecisionContext(trade_type==ORDER_TYPE_BUY?"BUY":"SELL",trade_source,stage_bull,stage_bear,signal_strength);
    WriteDecisionRecord(pending_decision_id,"ENTRY_REQUEST",trade_type==ORDER_TYPE_BUY?"BUY":"SELL",trade_source,entry_price,stop_loss,take_profit,lot_size,stage_bull,stage_bear,"",signal_strength);
    bool result=trade_type==ORDER_TYPE_BUY?trade.Buy(lot_size,_Symbol,0,stop_loss,take_profit,comment):trade.Sell(lot_size,_Symbol,0,stop_loss,take_profit,comment);
        if(result && (trade.ResultRetcode()==TRADE_RETCODE_DONE || trade.ResultRetcode()==TRADE_RETCODE_DONE_PARTIAL)) {
          double fill_price=trade.ResultPrice();
          if(fill_price<=0) fill_price=entry_price;
          AddTradeToMonitoring(trade.ResultOrder(),entry_price,stop_loss,take_profit,lot_size,trade_type,comment);
          RecoverOpenTrades();
          trades_today++; trades_this_hour++; last_trade_time=TimeCurrent();
          string executed_side=trade_type==ORDER_TYPE_BUY?"BUY":"SELL";
          Print("[NEXA][TRADE] EXECUTED | id=",pending_decision_id," symbol=",_Symbol," side=",executed_side,
              " source=",trade_source," order=",trade.ResultOrder()," lots=",DoubleToString(lot_size,2),
              " fill=",DoubleToString(fill_price,_Digits)," SL=",DoubleToString(stop_loss,_Digits)," TP=",DoubleToString(take_profit,_Digits));
          AddMLDashboardLog(StringFormat("TRADE FILLED %s @ %s | SL %s TP %s",executed_side,DoubleToString(fill_price,_Digits),DoubleToString(stop_loss,_Digits),DoubleToString(take_profit,_Digits)));
          if(runtime_ml_enabled && ml_prediction_available) {
            Print("[NEXA][TRADE][ML] H1 bias=",ml_trend_direction,
                " M15 setup=",ml_prediction_setup_type,"/",ml_m15_signal,
                " confirmation=",ml_confirmation_status," entry=",ml_entry_status,
                " model=",ml_prediction_model_version);
            if(ml_potential_bullish_reversal_high>0 || ml_potential_bearish_reversal_high>0)
                Print("[NEXA][TRADE][ML] reversal_refs bull=",DoubleToString(ml_potential_bullish_reversal_low,_Digits),"-",DoubleToString(ml_potential_bullish_reversal_high,_Digits),
                    " (",ml_bullish_reversal_source,") bear=",DoubleToString(ml_potential_bearish_reversal_low,_Digits),"-",DoubleToString(ml_potential_bearish_reversal_high,_Digits),
                    " (",ml_bearish_reversal_source,")");
            Print("[NEXA][TRADE][ML] breakout_refs up=",DoubleToString(ml_breakout_up,_Digits)," down=",DoubleToString(ml_breakout_down,_Digits));
          }
        }
    else {
        Print("Trade execution failed: ",trade.ResultRetcode()," ",trade.ResultRetcodeDescription());
        if(InpLogRejectedDecisions) WriteDecisionRecord(pending_decision_id,"ENTRY_FAILED",trade_type==ORDER_TYPE_BUY?"BUY":"SELL",trade_source,entry_price,stop_loss,take_profit,lot_size,stage_bull,stage_bear,"BROKER_RETCODE_"+IntegerToString(trade.ResultRetcode()),signal_strength);
    }
    pending_decision_id=""; stage_direction="";
}

//+------------------------------------------------------------------+
//| Calculate stop loss and take profit                           |
//+------------------------------------------------------------------+
void CalculateStopLossAndTakeProfit(ENUM_ORDER_TYPE trade_type,double entry_price,double &stop_loss,double &take_profit) {
    stop_loss=ml_stop_loss; take_profit=ml_take_profit; // Exact ML prices, no ATR/pip/local fallback.
}

//+------------------------------------------------------------------+
//| Calculate lot size based on risk                              |
//+------------------------------------------------------------------+
double CalculateLotSize(double entry_price, double stop_loss_price) {
    if(!runtime_use_risk_lots) return NormalizeVolume(runtime_fixed_lot);
    double risk_amount=AccountInfoDouble(ACCOUNT_BALANCE)*runtime_risk_percentage/100.0,loss_for_one_lot=0;
    ENUM_ORDER_TYPE side=stop_loss_price<entry_price?ORDER_TYPE_BUY:ORDER_TYPE_SELL;
    if(!OrderCalcProfit(side,_Symbol,1.0,entry_price,stop_loss_price,loss_for_one_lot)){ Print("[NEXA][ERROR] Lot calculation failed: ",GetLastError());return 0; }
    loss_for_one_lot=MathAbs(loss_for_one_lot); if(loss_for_one_lot<=0)return 0; double raw_lots=risk_amount/loss_for_one_lot;
    if(raw_lots<SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN)) { Print("[NEXA][BLOCK] Broker minimum volume exceeds risk budget"); return 0; }
    double lots=NormalizeVolume(raw_lots);
    if(runtime_decision_logs)Print("[NEXA][RISK] Balance=",DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE),2)," Risk=",DoubleToString(runtime_risk_percentage,2),"% Lots=",DoubleToString(lots,2)); return lots;
}

//+------------------------------------------------------------------+
//| Add trade to monitoring                                       |
//+------------------------------------------------------------------+
void AddTradeToMonitoring(ulong ticket, double entry_price, double stop_loss, double take_profit, 
                         double lot_size, ENUM_ORDER_TYPE trade_type, string comment) {
    int size = ArraySize(active_trades);
    ArrayResize(active_trades, size + 1);
    
    active_trades[size].ticket = ticket;
    active_trades[size].position_id = 0;
    active_trades[size].order_ticket = ticket;
    active_trades[size].entry_deal_ticket = 0;
    active_trades[size].decision_id = pending_decision_id;
    active_trades[size].entry_price = entry_price;
    active_trades[size].initial_stop_loss = stop_loss;
    active_trades[size].stop_loss = stop_loss;
    active_trades[size].take_profit = take_profit;
    active_trades[size].original_lot_size = lot_size;
    active_trades[size].remaining_lot_size = lot_size;
    active_trades[size].break_even_moved = false;
    active_trades[size].trailing_active = false;
    active_trades[size].tp1_hit = false;
    active_trades[size].tp2_hit = false;
    active_trades[size].tp3_hit = false;
    active_trades[size].entry_time = TimeCurrent();
    active_trades[size].trade_type = (trade_type == ORDER_TYPE_BUY) ? 0 : 1;
    active_trades[size].comment = comment;
    active_trades[size].scalp_mode = IsScalpMode();
    active_trades[size].mfe = 0;
    active_trades[size].mae = 0;
    active_trades[size].cumulative_gross = 0;
    active_trades[size].cumulative_commission = 0;
    active_trades[size].cumulative_swap = 0;
    active_trades[size].cumulative_net = 0;
    active_trades[size].realized_volume = 0;
    active_trades[size].cumulative_realized_move = 0;
    active_trades[size].partial_info = "NONE";
    active_trades[size].last_exit_time = 0;
    active_trades[size].final_closing_reason = "";
    active_trades[size].outcome_written = false;
    active_trades[size].archived_at = 0;
    active_trades[size].ctx_session = stage_session;
    active_trades[size].ctx_regime = stage_regime;
    active_trades[size].ctx_ranging = stage_ranging;
    active_trades[size].ctx_volatility = stage_volatility;
    active_trades[size].ctx_direction = stage_direction;
    active_trades[size].ctx_source = stage_source;
    active_trades[size].ctx_mode = stage_mode;
    active_trades[size].ctx_snapshot = stage_snapshot;
    active_trades[size].ctx_key_readings = stage_key_readings;
    active_trades[size].ctx_bull = stage_bull;
    active_trades[size].ctx_bear = stage_bear;
    active_trades[size].ctx_confirmations = stage_confirmations;
    active_trades[size].ctx_spread = stage_spread;
}

//+------------------------------------------------------------------+
//| Manage existing trades                                        |
//+------------------------------------------------------------------+
void ManageExistingTrades() {
    // Protective prices are broker-held. No locally calculated breakeven/trailing/partial exits.
    for(int i=ArraySize(active_trades)-1;i>=0;i--) {
        if(!position.SelectByTicket(active_trades[i].ticket)) { ArchiveTrade(i); continue; }
        double quote=SymbolInfoDouble(_Symbol,active_trades[i].trade_type==0?SYMBOL_BID:SYMBOL_ASK);
        double excursion=active_trades[i].trade_type==0?quote-active_trades[i].entry_price:active_trades[i].entry_price-quote;
        active_trades[i].mfe=MathMax(active_trades[i].mfe,excursion); active_trades[i].mae=MathMin(active_trades[i].mae,excursion);
    }
}

//+------------------------------------------------------------------+
//| Remove trade from array                                       |
//+------------------------------------------------------------------+
void RemoveTradeFromArray(int index) {
    if(index < 0 || index >= ArraySize(active_trades)) return;
    
    for(int i = index; i < ArraySize(active_trades) - 1; i++) {
        active_trades[i] = active_trades[i + 1];
    }
    ArrayResize(active_trades, ArraySize(active_trades) - 1);
}

//+------------------------------------------------------------------+
//| Update counters                                               |
//+------------------------------------------------------------------+
void UpdateCounters() {
    datetime current_time = TimeCurrent();
    MqlDateTime dt;
    TimeToStruct(current_time, dt);
    
    // Reset daily counter
    datetime current_date = current_time - (current_time % 86400);
    if(current_date != last_trade_date) {
        trades_today = 0;
        last_trade_date = current_date;
        if(runtime_debug_logs) Print("[DAY] New trading day - Counters reset");
    }
    
    // Reset hourly counter
    datetime current_hour = current_time - (current_time % 3600);
    if(current_hour != last_hour_reset) {
        trades_this_hour = 0;
        last_hour_reset = current_hour;
        if(runtime_debug_logs) Print("[HOUR] New trading hour - Hour counter reset");
    }
}

//+------------------------------------------------------------------+
//| Reset counters                                                |
//+------------------------------------------------------------------+
void ResetCounters() {
    trades_today=0; trades_this_hour=0; last_trade_time=0;
    datetime now=TimeCurrent(); last_trade_date=now-now%86400; last_hour_reset=now-now%3600;
    if(!HistorySelect(last_trade_date,now))return;
    ulong counted[];
    for(int i=0;i<HistoryDealsTotal();i++) {
        ulong deal=HistoryDealGetTicket(i);
        if(deal==0 || HistoryDealGetInteger(deal,DEAL_MAGIC)!=EA_MAGIC_NUMBER || HistoryDealGetString(deal,DEAL_SYMBOL)!=_Symbol || HistoryDealGetInteger(deal,DEAL_ENTRY)!=DEAL_ENTRY_IN)continue;
        ulong order_id=(ulong)HistoryDealGetInteger(deal,DEAL_ORDER); bool seen=false;
        for(int j=0;j<ArraySize(counted);j++)if(counted[j]==order_id){seen=true;break;}
        if(seen)continue; int n=ArraySize(counted); ArrayResize(counted,n+1); counted[n]=order_id;
        datetime time=(datetime)HistoryDealGetInteger(deal,DEAL_TIME); trades_today++; if(time>=last_hour_reset)trades_this_hour++;
        last_trade_time=MathMax(last_trade_time,time);
    }
}

//+------------------------------------------------------------------+
//| Expert timer function                                           |
//+------------------------------------------------------------------+
void OnTimer() {
    uint now=GetTickCount();
    if(now-dashboard_last_refresh>=(uint)runtime_refresh_ms) { dashboard_last_refresh=now; UpdateDashboard(); }
    UpdateCounters();
    static datetime last_heartbeat=0;
    if(TimeLocal()-last_heartbeat>=60) { last_heartbeat=TimeLocal(); WriteTelemetryHeartbeat(runtime_trading_enabled?"ACTIVE":"STOPPED"); }
    if(LicenseTradingAllowed()) UpdateMLPrediction();
    string gate_status=ModeReadinessText();
    if(gate_status!=ml_last_gate_status) { ml_last_gate_status=gate_status; AddMLDashboardLog("EXECUTION GATE | "+gate_status); if(runtime_decision_logs)Print("[NEXA][GATE] ",gate_status); }
}

//+------------------------------------------------------------------+
//| Strategy Tester summary: confirms the ML dataset was written     |
//+------------------------------------------------------------------+
double OnTester() {
    Print("NEXA ML dataset written to tester Files folder: ",DataFileName("decisions"),", ",DataFileName("outcomes")," and ",DataFileName("ml"));
    Print("NEXA decision mode during this run: ",MLModeText()," | ML service link: ",MLLinkStateText());
    return TesterStatistics(STAT_PROFIT);
}

//+------------------------------------------------------------------+
//| Dashboard interaction                                           |
//+------------------------------------------------------------------+
void OnChartEvent(const int id,const long &lparam,const double &dparam,const string &sparam) {
    if(StringFind(sparam,dashboard_prefix)!=0)return;
    //--- rounded-corner masks and decorative strips are cosmetic only
    if(StringFind(sparam,dashboard_prefix+"RC_")==0 || StringFind(sparam,dashboard_prefix+"SBAR_")==0) return;
    if(id==CHARTEVENT_OBJECT_DRAG && sparam==DashName("DragHandle")){
        dashboard_x=(int)ObjectGetInteger(0,sparam,OBJPROP_XDISTANCE)-DS(1); dashboard_y=(int)ObjectGetInteger(0,sparam,OBJPROP_YDISTANCE)-DS(1);
        Print("[NEXA][DASHBOARD] Moved to x=",dashboard_x," y=",dashboard_y); RenderDashboard(); return;
    }
    if(id==CHARTEVENT_OBJECT_CLICK && sparam==DashName("DragHandle")) {
        ObjectSetInteger(0,sparam,OBJPROP_SELECTED,true);
        return;
    }
    if(id!=CHARTEVENT_OBJECT_CLICK)return; string key=StringSubstr(sparam,StringLen(dashboard_prefix));
    if(StringFind(key,"TAB")==0){dashboard_tab=(int)StringToInteger(StringSubstr(key,3));RenderDashboard();return;}
    if(key=="MinTop"||key=="Minimize"){dashboard_minimized=!dashboard_minimized;RenderDashboard();return;}
    if(key=="StartTrading"){if(!LicenseTradingAllowed()){Print("[NEXA][BLOCK] ",runtime_license_status);RenderDashboard();return;}runtime_trading_enabled=true;runtime_new_trades_enabled=true;Print("[NEXA][CONTROL] Trading started");}
    else if(key=="StopTrading"){runtime_new_trades_enabled=false;runtime_trading_enabled=false;Print("[NEXA][CONTROL] Trading stopped; closing EA positions");CloseAllEAPositions();}
    else if(key=="NewTrades")runtime_new_trades_enabled=!runtime_new_trades_enabled;
    else if(key=="Buy")runtime_buy_enabled=!runtime_buy_enabled; else if(key=="Sell")runtime_sell_enabled=!runtime_sell_enabled;
    else if(key=="RiskMode")runtime_use_risk_lots=!runtime_use_risk_lots;
    else if(key=="ModeAuto")runtime_operating_mode=NEXA_AUTO; else if(key=="ModeSwing")runtime_operating_mode=NEXA_SWING; else if(key=="ModeScalp")runtime_operating_mode=NEXA_SCALP;
    else if(key=="NewsFilter")runtime_use_news=!runtime_use_news; else if(key=="NewsMinus")runtime_news_minutes=MathMax(5,runtime_news_minutes-5); else if(key=="NewsPlus")runtime_news_minutes=MathMin(240,runtime_news_minutes+5);
    else if(key=="SessionFilter")runtime_use_session=!runtime_use_session; else if(key=="Asian")runtime_trade_asian=!runtime_trade_asian; else if(key=="London")runtime_trade_london=!runtime_trade_london; else if(key=="NewYork")runtime_trade_new_york=!runtime_trade_new_york;
    else if(key=="StartHourMinus")runtime_session_start=NormalizeHour(runtime_session_start-1); else if(key=="StartHourPlus")runtime_session_start=NormalizeHour(runtime_session_start+1); else if(key=="EndHourMinus")runtime_session_end=NormalizeHour(runtime_session_end-1); else if(key=="EndHourPlus")runtime_session_end=NormalizeHour(runtime_session_end+1);
    else if(key=="StartML"){runtime_ml_enabled=true;Print("[NEXA][AI] NEXA ML activated; ML-only execution active");}
    else if(key=="StopML"){runtime_ml_enabled=false;active_trading_mode="WAIT";ClearMLPrediction("NEXA ML paused; new entries disabled");Print("[NEXA][AI] NEXA ML paused; new entries disabled");}
    else if(key=="ConfidenceMinus"){runtime_ml_execution_confidence=MathMax(SCALP_MIN_ML_CONFIDENCE,runtime_ml_execution_confidence-5.0);Print("[NEXA][ML] Execution confidence set to ",DoubleToString(runtime_ml_execution_confidence,0),"%");}
    else if(key=="ConfidencePlus"){runtime_ml_execution_confidence=MathMin(100.0,runtime_ml_execution_confidence+5.0);Print("[NEXA][ML] Execution confidence set to ",DoubleToString(runtime_ml_execution_confidence,0),"%");}
    else if(key=="ScaleMinus")dashboard_scale=MathMax(75,dashboard_scale-5); else if(key=="ScalePlus")dashboard_scale=MathMin(150,dashboard_scale+5);
    else if(key=="ResetPosition"){dashboard_x=InpDashboardX;dashboard_y=InpDashboardY;}
    else if(StringFind(key,"Theme")==0)dashboard_theme=(int)StringToInteger(StringSubstr(key,5));
    else if(key=="DebugLogs")runtime_debug_logs=!runtime_debug_logs; else if(key=="DecisionLogs")runtime_decision_logs=!runtime_decision_logs;
    else if(key=="Trading")runtime_trading_enabled=!runtime_trading_enabled;
    else if(key=="DailyMinus")runtime_max_daily=(int)MathMax(1,runtime_max_daily-1); else if(key=="DailyPlus")runtime_max_daily=(int)MathMin(50,runtime_max_daily+1);
    else if(key=="HourlyMinus")runtime_max_hourly=(int)MathMax(1,runtime_max_hourly-1); else if(key=="HourlyPlus")runtime_max_hourly=(int)MathMin(50,runtime_max_hourly+1);
    else if(key=="PositionsMinus")runtime_max_positions=(int)MathMax(1,runtime_max_positions-1); else if(key=="PositionsPlus")runtime_max_positions=(int)MathMin(20,runtime_max_positions+1);
    else if(key=="ScalpPositionsMinus")runtime_scalp_max_positions=(int)MathMax(1,runtime_scalp_max_positions-1); else if(key=="ScalpPositionsPlus")runtime_scalp_max_positions=(int)MathMin(20,runtime_scalp_max_positions+1);
    else if(key=="IntervalMinus")runtime_min_trade_minutes=(int)MathMax(0,runtime_min_trade_minutes-1); else if(key=="IntervalPlus")runtime_min_trade_minutes=(int)MathMin(240,runtime_min_trade_minutes+1);
    else if(key=="RefreshMinus")runtime_refresh_ms=(int)MathMax(100,runtime_refresh_ms-50); else if(key=="RefreshPlus")runtime_refresh_ms=(int)MathMin(2000,runtime_refresh_ms+50);
    else if(key=="RiskMinus")runtime_risk_percentage=MathMax(0.1,runtime_risk_percentage-0.1); else if(key=="RiskPlus")runtime_risk_percentage=MathMin(10.0,runtime_risk_percentage+0.1);
    else if(key=="LotMinus")runtime_fixed_lot=MathMax(SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN),runtime_fixed_lot-SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP)); else if(key=="LotPlus")runtime_fixed_lot=MathMin(SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX),runtime_fixed_lot+SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP));
    else if(key=="SpreadMinus")runtime_max_spread_pips=MathMax(0.1,runtime_max_spread_pips-0.1); else if(key=="SpreadPlus")runtime_max_spread_pips=MathMin(100.0,runtime_max_spread_pips+0.1);
    else if(key=="OffsetMinus")runtime_broker_utc_offset=(int)MathMax(-23,runtime_broker_utc_offset-1); else if(key=="OffsetPlus")runtime_broker_utc_offset=(int)MathMin(23,runtime_broker_utc_offset+1);
    else if(key=="MLPollMinus")runtime_ml_check_seconds=(int)MathMax(1,runtime_ml_check_seconds-1); else if(key=="MLPollPlus")runtime_ml_check_seconds=(int)MathMin(60,runtime_ml_check_seconds+1);
    else if(key=="TimeoutMinus")runtime_ml_timeout_ms=(int)MathMax(500,runtime_ml_timeout_ms-250); else if(key=="TimeoutPlus")runtime_ml_timeout_ms=(int)MathMin(5000,runtime_ml_timeout_ms+250);
    else if(key=="FreshnessMinus")runtime_prediction_max_age_seconds=(int)MathMax(5,runtime_prediction_max_age_seconds-5); else if(key=="FreshnessPlus")runtime_prediction_max_age_seconds=(int)MathMin(120,runtime_prediction_max_age_seconds+5);
    else if(key=="SpreadFilter")runtime_spread_filter=!runtime_spread_filter;
    ObjectSetInteger(0,sparam,OBJPROP_STATE,false);
    PrintRuntimeSettings("CONTROL UPDATED: "+key); RenderDashboard();
}

void OnTradeTransaction(const MqlTradeTransaction &trans,const MqlTradeRequest &request,const MqlTradeResult &result) {
    if(trans.type!=TRADE_TRANSACTION_DEAL_ADD || trans.deal==0)return;
    if(!HistoryDealSelect(trans.deal))return;
    if((long)HistoryDealGetInteger(trans.deal,DEAL_MAGIC)!=EA_MAGIC_NUMBER)return;
    long entry_type=HistoryDealGetInteger(trans.deal,DEAL_ENTRY); ulong position_id=(ulong)HistoryDealGetInteger(trans.deal,DEAL_POSITION_ID);
    ulong order_ticket=(ulong)HistoryDealGetInteger(trans.deal,DEAL_ORDER); string deal_comment=HistoryDealGetString(trans.deal,DEAL_COMMENT);
    if(entry_type==DEAL_ENTRY_IN){
        int entry_index=FindTradeByIdentity(order_ticket,trans.deal,position_id,deal_comment);
        if(entry_index>=0) {
            active_trades[entry_index].position_id=position_id;
            active_trades[entry_index].ticket=trans.position;
            active_trades[entry_index].order_ticket=order_ticket;
            active_trades[entry_index].entry_deal_ticket=trans.deal;
            if(active_trades[entry_index].decision_id=="") active_trades[entry_index].decision_id=DecisionIdFromComment(deal_comment,position_id);
        }
        return;
    }
    if(entry_type!=DEAL_ENTRY_OUT && entry_type!=DEAL_ENTRY_OUT_BY)return;

    int live_index=FindTradeByIdentity(0,0,position_id,deal_comment); int closed_index=-1; bool found=live_index>=0;
    TradeInfo record;
    if(found) record=active_trades[live_index];
    else { closed_index=FindClosedTradeByIdentity(position_id,trans.position); found=closed_index>=0; if(found) record=closed_trades[closed_index]; }
    if(found && record.outcome_written) return;

    if(!found) {
        if(runtime_debug_logs) Print("Outcome deferred: no tracked trade decision=",DecisionIdFromComment(deal_comment,position_id)," position=",position_id," deal=",trans.deal);
        return;
    }

    datetime exit_time=(datetime)HistoryDealGetInteger(trans.deal,DEAL_TIME);
    double exit_price=HistoryDealGetDouble(trans.deal,DEAL_PRICE);
    double gross=HistoryDealGetDouble(trans.deal,DEAL_PROFIT);
    double commission=HistoryDealGetDouble(trans.deal,DEAL_COMMISSION);
    double swap=HistoryDealGetDouble(trans.deal,DEAL_SWAP);
    double deal_volume=HistoryDealGetDouble(trans.deal,DEAL_VOLUME);
    bool valid_deal=exit_time>0 && exit_price>0 && deal_volume>0 && MathIsValidNumber(gross) && MathIsValidNumber(commission) && MathIsValidNumber(swap);
    if(!valid_deal || record.entry_time<=0 || exit_time<record.entry_time || record.entry_price<=0) {
        if(runtime_debug_logs) Print("Outcome deferred: invalid deal data decision=",record.decision_id," position=",position_id," deal=",trans.deal," time=",(long)exit_time," price=",DoubleToString(exit_price,_Digits)," volume=",DoubleToString(deal_volume,2));
        return;
    }

    string id=record.decision_id!=""?record.decision_id:DecisionIdFromComment(deal_comment,position_id);
    double entry_price=record.entry_price;
    double fill_price=entry_price;
    if(HistorySelectByPosition(position_id))
        for(int d=0;d<HistoryDealsTotal();d++){ ulong dt=HistoryDealGetTicket(d); if(dt>0 && HistoryDealGetInteger(dt,DEAL_ENTRY)==DEAL_ENTRY_IN){ fill_price=HistoryDealGetDouble(dt,DEAL_PRICE); break; } }

    double net=gross+commission+swap;

    if(found) {
        record.cumulative_gross+=gross; record.cumulative_commission+=commission; record.cumulative_swap+=swap; record.cumulative_net+=net;
        double deal_move=record.trade_type==0?HistoryDealGetDouble(trans.deal,DEAL_PRICE)-fill_price:fill_price-HistoryDealGetDouble(trans.deal,DEAL_PRICE);
        record.realized_volume+=deal_volume; record.cumulative_realized_move+=deal_move*deal_volume; record.last_exit_time=exit_time;
        record.final_closing_reason=EnumToString((ENUM_DEAL_REASON)HistoryDealGetInteger(trans.deal,DEAL_REASON));
        if(record.partial_info=="NONE" || record.partial_info=="RECOVERED_AFTER_RESTART") record.partial_info="";
        if(record.partial_info!="") record.partial_info+="|";
        record.partial_info+=StringFormat("DEAL_VOLUME=%.2f;GROSS=%.2f;COMMISSION=%.2f;SWAP=%.2f;NET=%.2f;REASON=%s",deal_volume,gross,commission,swap,net,record.final_closing_reason);
        if(live_index>=0) active_trades[live_index]=record; else if(closed_index>=0) closed_trades[closed_index]=record;
        if(IsPositionStillOpen(position_id,trans.position)) return;
        if(record.outcome_written) return;
    }

    //--- R multiple from price distance: (realised move) / (initial risk distance)
    double risk_distance=found?MathAbs(record.entry_price-record.initial_stop_loss):0;
    double move=found?((record.trade_type==0)?(exit_price-fill_price):(fill_price-exit_price)):0;
    double realized_move=found && record.original_lot_size>0?record.cumulative_realized_move/record.original_lot_size:move;
    double r_multiple=(risk_distance>0)?realized_move/risk_distance:0;

    double mfe_points=found?record.mfe/_Point:0;
    double mae_points=found?record.mae/_Point:0;
    string partial_info=found?record.partial_info:"UNLINKED";
    if(found) partial_info+=StringFormat("|TP1=%s;TP2=%s;TP3=%s;REALIZED_VOLUME=%.2f;REMAINING=%.2f",record.tp1_hit?"1":"0",record.tp2_hit?"1":"0",record.tp3_hit?"1":"0",record.realized_volume,record.remaining_lot_size);

    record.outcome_written=true;
    if(live_index>=0) active_trades[live_index]=record; else if(closed_index>=0) closed_trades[closed_index]=record;
    if(!WriteOutcomeRecord(id,position_id,entry_price,fill_price,exit_price,exit_time,
                       found?record.cumulative_gross:gross,found?record.cumulative_commission:commission,found?record.cumulative_swap:swap,found?record.cumulative_net:net,
                       (found?record.cumulative_net:net)>=0?"WIN":"LOSS",r_multiple,mfe_points,mae_points,
                       record.final_closing_reason,partial_info,record,true)) {
        record.outcome_written=false;
        if(live_index>=0) active_trades[live_index]=record; else if(closed_index>=0) closed_trades[closed_index]=record;
        if(runtime_debug_logs) Print("Outcome deferred: outcome write failed decision=",id," position=",position_id," deal=",trans.deal);
        return;
    }

    if(live_index>=0) {
        active_trades[live_index]=record;
        if(!position.SelectByTicket(active_trades[live_index].ticket)) RemoveTradeFromArray(live_index);
    }
}
