string IndicatorSideText(bool bullish, bool bearish) {
    if(bullish) return "BUY";
    if(bearish) return "SELL";
    return "--";
}

void UpdateDashboard() {
    if(!InpShowDashboard) return;
    color green = DashGreen(), red = DashRed(), amber = DashAmber();
    color white = DashTextColor(), grey = DashMuted(), gold = DashGold();
    bool connected = ml_server_online && ml_predict_ok;
    bool health_reached = ml_health_reached;
    int bullish = (int)current_signals.rsi_bullish + (int)current_signals.ema_bullish +
        (int)current_signals.macd_bullish + (int)current_signals.price_action_bullish;
    int bearish = (int)current_signals.rsi_bearish + (int)current_signals.ema_bearish +
        (int)current_signals.macd_bearish + (int)current_signals.price_action_bearish;
    bool ready_buy = ml_predict_ok && ml_trend == 1 && bullish >= 3;
    bool ready_sell = ml_predict_ok && ml_trend == -1 && bearish >= 3;
    bool entry_ready = ready_buy || ready_sell;
    color trend_color = !ml_predict_ok ? grey : (ml_trend == 1 ? green : (ml_trend == -1 ? red : amber));
    color status_color = connected ? green : (health_reached ? amber : red);
    string trend_text = !ml_predict_ok ? "WAITING FOR ML" : (ml_trend == 1 ? "BUY TREND" : (ml_trend == -1 ? "SELL TREND" : "RANGE"));
    string trend_detail = "API HOST: "+BaseURL();
    string alignment_text = entry_ready
        ? (ready_buy ? "ENTRY READY  |  BUY signals agree with ML BUY" : "ENTRY READY  |  SELL signals agree with ML SELL")
        : (!ml_predict_ok ? "NO ENTRY  |  waiting for a valid ML trend"
        : (ml_trend == 0 ? "NO ENTRY  |  ML trend is RANGE"
        : StringFormat("NO ENTRY  |  need %s indicators to confirm ML %s",
            ml_trend == 1 ? "BUY" : "SELL", ml_trend == 1 ? "BUY" : "SELL")));
    color alignment_color = entry_ready ? green : red;

    DashRect("status_pill", DX+337, DY+12, 96, 22,
        connected ? C'22,53,43' : (health_reached ? C'61,49,27' : C'59,34,37'), status_color);
    DashText("status_text", DX+343, DY+18,
        connected ? "ML CONNECTED" : (health_reached ? "API CHECK" : "ML OFFLINE"),
        status_color, 7, "Segoe UI Semibold");
    DashText("trend_value", DX+30, DY+91, trend_text, trend_color, 19, "Segoe UI Semibold");
    DashText("confidence", DX+300, DY+94,
        ml_predict_ok && ml_confidence > 0 ? "MODEL "+DoubleToString(ml_confidence,1)+"%" : "MODEL --",
        ml_predict_ok ? gold : grey, 9, "Segoe UI Semibold");
    string connection_error = ml_predict_ok
        ? "Inference OK  |  H1 trend must match entry signals"
        : ml_last_error;
    if(!ml_predict_ok && StringFind(connection_error,"1003")>=0)
        connection_error += " | Check API HOST and Cloudflare hostname routing";
    DashText("server_detail", DX+30, DY+128, trend_detail, gold, 8);
    DashText("trend_error", DX+30, DY+148,
        StringSubstr(connection_error,0,78),
        ml_predict_ok ? green : amber, 7);
    DashText("trend_error_detail", DX+30, DY+160,
        StringSubstr(connection_error,78,78),
        ml_predict_ok ? green : amber, 7);
    DashText("connection_stage", DX+30, DY+173,
        StringSubstr("CONNECTION: "+(health_reached && !connected
            ? "HEALTH OK; INFERENCE FAILED"
            : ml_connection_stage),0,76),
        connected ? green : (health_reached ? amber : red), 7, "Segoe UI Semibold");

    DashText("indicator_summary", DX+30, DY+235,
        StringFormat("BUY %d/4     SELL %d/4", bullish, bearish),
        bullish > bearish ? green : (bearish > bullish ? red : amber), 10, "Segoe UI Semibold");
    DashText("rsi_label", DX+30, DY+261,
        "RSI  "+IndicatorSideText(current_signals.rsi_bullish,current_signals.rsi_bearish),
        current_signals.rsi_bullish ? green : (current_signals.rsi_bearish ? red : grey), 8, "Segoe UI Semibold");
    DashText("ema_label", DX+128, DY+261,
        "EMA  "+IndicatorSideText(current_signals.ema_bullish,current_signals.ema_bearish),
        current_signals.ema_bullish ? green : (current_signals.ema_bearish ? red : grey), 8, "Segoe UI Semibold");
    DashText("macd_label", DX+226, DY+261,
        "MACD  "+IndicatorSideText(current_signals.macd_bullish,current_signals.macd_bearish),
        current_signals.macd_bullish ? green : (current_signals.macd_bearish ? red : grey), 8, "Segoe UI Semibold");
    DashText("pa_label", DX+324, DY+261,
        "PRICE ACTION  "+IndicatorSideText(current_signals.price_action_bullish,current_signals.price_action_bearish),
        current_signals.price_action_bullish ? green : (current_signals.price_action_bearish ? red : grey), 7, "Segoe UI Semibold");
    DashRect("entry_pill", DX+30, DY+284, DW-60, 30,
        entry_ready ? C'22,53,43' : C'47,39,29', entry_ready ? green : amber);
    DashText("alignment", DX+42, DY+293, alignment_text,
        entry_ready ? green : (ml_predict_ok ? amber : red), 8, "Segoe UI Semibold");

    DashText("trades_value", DX+30, DY+390,
        IntegerToString(trades_today)+" / "+IntegerToString(InpMaxTradesPerDay), white, 12, "Segoe UI Semibold");
    DashText("positions_value", DX+163, DY+390,
        IntegerToString(PositionsTotal()), white, 12, "Segoe UI Semibold");
    DashText("equity_value", DX+292, DY+390,
        DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY),2)+" "+AccountInfoString(ACCOUNT_CURRENCY),
        white, 10, "Segoe UI Semibold");
    DashText("decision_value", DX+30, DY+460,
        StringSubstr(last_decision, 0, 76), white, 8);
    DashText("footer_right", DX+250, DY+507,
        ml_last_update > 0 ? "UPDATED "+TimeToString(ml_last_update,TIME_MINUTES|TIME_SECONDS) : "UPDATED --",
        grey, 7);
    DashText("footer_left", DX+18, DY+507, _Symbol+"  |  "+EnumToString(PERIOD_CURRENT), grey, 7);
    ChartRedraw();
}
